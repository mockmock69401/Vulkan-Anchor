#version 450
//2026-11-09 (session 6): the shader weather overlay (weather.glsl's model), one invocation per full-resolution pixel. It writes the
// rain and snow in front of the scene as premultiplied display colour and coverage; post_final.frag (no anti-aliasing) or post_blit.frag
// (after TAA and SMAA, so the thin moving streaks are not smeared by the history) blends it over the final image: out = c (1 - a) + rgb.
// Runs only while it rains or snows with the setting on (WeatherUniforms); vanilla's columns are then not drawn (ShaderWeather).
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform writeonly restrict image2D weatherOut;
layout(binding = 1) uniform sampler2D mainDepth;
layout(binding = 2) uniform sampler2D lodDepth;
//PrecipitationMap: one packed column per texel (world column & WEATHER_MAP_MASK)
layout(binding = 3) uniform usampler2D precipitationMap;
layout(binding = 4, std430) readonly restrict buffer LightData { uint lightData[]; };
layout(binding = 5, std430) readonly restrict buffer LightReady { uint lightReady[]; };
//Vanilla's lightmap (block light along u, sky light along v, display values)
layout(binding = 6) uniform sampler2D lightmapTex;

//The view (unjittered: the overlay is drawn after TAA) and the depths, as the composite's slots 0, 1, 2, 8 (AtmosphereUniforms)
layout(location = 0) uniform mat4 invVanillaProj;
layout(location = 1) uniform mat4 invLodProj;
layout(location = 2) uniform mat4 invView;
layout(location = 3) uniform vec4 depthParams;
//LightVolumeUniforms (WEATHER_FIRST 4): the light volume around the camera
layout(location = 4) uniform vec4 lightCamera;
layout(location = 5) uniform vec4 lightFrac;
layout(location = 6) uniform vec4 lightSize;
layout(location = 7) uniform vec4 lightMode;
//WeatherUniforms: weatherPixel's camera, frac, params, rain and snow; the drops' tints (rgb rain, snow; w unused)
layout(location = 8) uniform vec4 weatherCamera;
layout(location = 9) uniform vec4 weatherFrac;
layout(location = 10) uniform vec4 weatherParams;
layout(location = 11) uniform vec4 rainMotion;
layout(location = 12) uniform vec4 snowMotion;
layout(location = 13) uniform vec4 rainTint;
layout(location = 14) uniform vec4 snowTint;
//2026-11-10, WeatherUniforms: the splashes on the ground (weatherSplash): x the time wrapped at SPLASH_WRAP periods, yzw 0
layout(location = 15) uniform vec4 splashParams;
//2026-11-10, WeatherUniforms: the rings on the water (weatherImpact): x their time and y the rain on the water (reflection.comp's
// rainParams), zw water.glsl's first ripple offset (RippleMath.offsets)
layout(location = 16) uniform vec4 waterRain;

#import <vulkanmod:visuals/util/depthutils.glsl>
#import <vulkanmod:visuals/post/viewpos.glsl>

//lightvolume.glsl's lightByte (kept in step with it; that file needs the composite's bindings): world block b's byte (sky low nibble,
// block high), -1 when its section is not in the volume (yet)
int weatherLightMod(int a, int n) {
    return a - n*int(floor(float(a)/float(n)));
}

int weatherLightByte(ivec3 b) {
    ivec3 section = b >> 4;
    ivec3 n = ivec3(lightSize.xyz);
    int sy = section.y - int(lightSize.w);
    if (sy < 0 || sy >= n.y) {
        return -1;
    }
    int slot = weatherLightMod(section.x, n.x) + n.x*(weatherLightMod(section.z, n.z) + n.z*sy);
    uint key = uint(section.x & 0xFFF) | (uint(section.z & 0xFFF) << 12) | (uint((section.y - int(lightSize.w)) & 0x7F) << 24) | 0x80000000u;
    if (lightReady[slot] != key) {
        return -1;
    }
    ivec3 l = b & 15;
    uint index = uint(slot)*4096u + uint(l.y*256 + l.z*16 + l.x);
    return int((lightData[index >> 2u] >> ((index & 3u)*8u)) & 0xFFu);
}

uint weatherMapAt(ivec2 texel) {
    return texelFetch(precipitationMap, texel, 0).r;
}

//As vanilla lights its weather (LevelRenderer.renderSnowAndRain): the lightmap at the drop's block and sky light (the sky full: drops
// fall only under open sky), snow lifted toward full as vanilla does ((l * 3 + 15) / 4 in levels); the block light from the light volume
// when it knows the drop's block
vec3 weatherLight(vec3 rel, bool snow) {
    vec2 l = vec2(0.0, 15.0);
    if (lightCamera.w > 0.0) {
        int b = weatherLightByte(ivec3(lightCamera.xyz) + ivec3(floor(lightFrac.xyz + rel)));
        if (b >= 0) {
            l = vec2(float(b >> 4), float(b & 15));
        }
    }
    if (snow) {
        l = (l*3.0 + 15.0)/4.0;
    }
    vec3 light = texture(lightmapTex, (clamp(l, 0.0, 15.0) + 0.5)/16.0).rgb;
    return light*(snow ? snowTint.rgb : rainTint.rgb);
}

//2026-11-10: the rings' drops (rainripple.glsl needs water.glsl's hash and ripple period)
#import <vulkanmod:visuals/post/water.glsl>
#import <vulkanmod:visuals/post/rainripple.glsl>
#import <vulkanmod:visuals/post/weather.glsl>

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(weatherOut);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    vec3 view;
    bool scene = scenePosition(p, size, view);
    float sceneDist = scene ? length(view) : 1e30;
    vec3 dir = normalize(mat3(invView)*viewRay(invVanillaProj, pixelUvGl(p, size)));
    vec4 acc = weatherPixel(dir, sceneDist, weatherCamera, weatherFrac, weatherParams, rainMotion, snowMotion);
    //2026-11-10: the splashes on the ground behind the drops
    if (scene && acc.a <= WEATHER_OPAQUE) {
        vec3 rel = mat3(invView)*view;
        vec4 s = weatherSplash(rel, dir, sceneDist, weatherCamera, weatherFrac, weatherParams, splashParams);
        //2026-11-10: and the crowns of the drops that ring the water
        vec4 c = weatherImpact(rel, dir, sceneDist, weatherCamera, weatherFrac, weatherParams, waterRain);
        s.rgb += (1.0 - s.a)*c.rgb;
        s.a += (1.0 - s.a)*c.a;
        acc.rgb += (1.0 - acc.a)*s.rgb;
        acc.a += (1.0 - acc.a)*s.a;
    }
    imageStore(weatherOut, p, acc);
}
