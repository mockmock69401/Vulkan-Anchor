#version 450
//2026-11-12 (session 14 follow-up, Half-resolution Weather & Sky): the half-size overlay (premultiplied colour, coverage) bilinearly
// up to the full-size image the final draw and SMAA's last pass read
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform writeonly restrict image2D dst;
layout(binding = 1) uniform sampler2D src;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    imageStore(dst, p, texture(src, (vec2(p) + 0.5)/vec2(size)));
}
