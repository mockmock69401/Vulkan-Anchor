#version 450 core
//Visuals P7i: the final colour (post_final.frag's) into an image, for SMAA, which needs the tone-mapped scene before the hand and
// the GUI and Reforged's main colour cannot be a storage image
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 3, rgba8) uniform writeonly restrict image2D ldrOut;

#import <vulkanmod:visuals/post/postfinal.glsl>

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(ldrOut)))) {
        return;
    }
    imageStore(ldrOut, p, finalColour(vec2(p) + 0.5));
}
