    offset[1]= fma(smaaMetrics . xyxy, vec4(1.0, 0.0, 0.0, 1.0), texcoord . xyxy);
    offset[2]= fma(smaaMetrics . xyxy, vec4(- 2.0, 0.0, 0.0, - 2.0), texcoord . xyxy);
