#version 450
//W9: temporal anti-aliasing on the final colour (display values, W2's post_ldr output). The level is drawn with a sub-pixel
// jitter (TaaJitter); here the history (the last result) is reprojected into this frame by depth and blended with the current
// pixel after clipping it to the current neighbourhood. Method from the literature (no code taken): Karis 2014, "High Quality
// Temporal Supersampling" (closest-depth reprojection, clipping toward the neighbourhood box in YCoCg); Salvi 2016, "An Excursion
// in Temporal Supersampling" (variance box); Jimenez 2016, "Filmic SMAA" (Catmull-Rom history fetch from five bilinear taps);
// Malvar and Sullivan 2003 (YCoCg). TaaMath mirrors every constant and step here: change both together.
//
// Output: rgb the anti-aliased colour, a the pixel's linear depth (clip w; SKY_DEPTH for the sky), which the next frame reads to
// drop history that showed something nearer (disocclusion).
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform writeonly restrict image2D taaOut;
layout(binding = 1) uniform sampler2D currentTex;
layout(binding = 2) uniform sampler2D historyTex;//linear filtering
layout(binding = 3) uniform sampler2D mainDepth;
layout(binding = 4) uniform sampler2D lodDepth;
layout(binding = 5) uniform sampler2D opaqueDepth;//the main depth before the translucent terrain

layout(location = 0) uniform mat4 invVanillaProj;//this frame's, without the jitter
layout(location = 1) uniform mat4 invLodProj;//this frame's, without the jitter
layout(location = 2) uniform mat4 prevFromView;//view position (w 1) or direction (w 0) to the previous frame's clip space, unjittered
layout(location = 3) uniform vec4 depthParams;//x LodClamp.CLAMP_THRESHOLD, y 1 when the LOD depth is valid
layout(location = 4) uniform vec4 taaParams;//x 1 when the history is valid, y vanilla's render distance (blocks)

#import <vulkanmod:visuals/util/depthutils.glsl>
#import <vulkanmod:visuals/post/viewpos.glsl>

const int JITTER_PHASES = 8;//TaaJitter's sequence length (Java side only)
const float JITTER_SCALE = 1.0;//the jitter pattern's width in pixels (Java side only)
const float CURRENT_WEIGHT = 0.1;
const float MOVING_CURRENT_WEIGHT = 0.2;
const float MOTION_RAMP_PIXELS = 4.0;
const float TRANSLUCENT_CURRENT_WEIGHT = 0.3;
const float CLIP_GAMMA = 1.0;
const float FAR_CLIP_GAMMA = 1.5;
const float TRANSLUCENT_CLIP_GAMMA = 0.75;
const float DISOCCLUSION_DEPTH = 0.1;
const float SKY_DEPTH = 60000.0;
const float BOX_EPS = 0.001;

vec3 toYCoCg(vec3 c) {
    return vec3(0.25*c.r + 0.5*c.g + 0.25*c.b, 0.5*c.r - 0.5*c.b, -0.25*c.r + 0.5*c.g - 0.25*c.b);
}

vec3 fromYCoCg(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

//TaaMath.reproject: a pixel's position (pixels from the top-left, centres at k + 0.5) in the previous frame and its previous clip w;
// false behind the camera. A view position has w 1, a sky direction w 0 (no camera translation).
bool reproject(vec3 view, float w, ivec2 size, out vec2 prevPos, out float prevW) {
    vec4 clip = prevFromView*vec4(view, w);
    prevW = clip.w;
    if (clip.w <= 0.0) {
        return false;
    }
    vec2 uv = clip.xy/clip.w*0.5 + 0.5;
    prevPos = vec2(uv.x, 1.0 - uv.y)*vec2(size);
    return true;
}

//Catmull-Rom over the 4x4 texels around pos (pixels), from five bilinear fetches (Jimenez 2016); the corners are left out and the
// weights renormalised. pos is in pixels from the top-left, which is the history's texel order.
vec3 historyCatmullRom(vec2 pos, vec2 invSize) {
    vec2 centre = floor(pos - 0.5) + 0.5;
    vec2 f = pos - centre;
    vec2 w0 = f*(-0.5 + f*(1.0 - 0.5*f));
    vec2 w1 = 1.0 + f*f*(-2.5 + 1.5*f);
    vec2 w2 = f*(0.5 + f*(2.0 - 1.5*f));
    vec2 w3 = f*f*(-0.5 + 0.5*f);
    vec2 w12 = w1 + w2;
    vec2 t0 = (centre - 1.0)*invSize;
    vec2 t3 = (centre + 2.0)*invSize;
    vec2 t12 = (centre + w2/w12)*invSize;
    float a = w12.x*w0.y, b = w0.x*w12.y, c = w12.x*w12.y, d = w3.x*w12.y, e = w12.x*w3.y;
    vec3 sum = textureLod(historyTex, vec2(t12.x, t0.y), 0.0).rgb*a
            + textureLod(historyTex, vec2(t0.x, t12.y), 0.0).rgb*b
            + textureLod(historyTex, t12, 0.0).rgb*c
            + textureLod(historyTex, vec2(t3.x, t12.y), 0.0).rgb*d
            + textureLod(historyTex, vec2(t12.x, t3.y), 0.0).rgb*e;
    return max(sum/(a + b + c + d + e), vec3(0.0));
}

//The largest depth the history stored on the 2x2 texels around pos
float historyMaxDepth(vec2 pos, ivec2 size) {
    ivec2 t = ivec2(floor(pos - 0.5));
    ivec2 last = size - 1;
    float d = texelFetch(historyTex, clamp(t, ivec2(0), last), 0).a;
    d = max(d, texelFetch(historyTex, clamp(t + ivec2(1, 0), ivec2(0), last), 0).a);
    d = max(d, texelFetch(historyTex, clamp(t + ivec2(0, 1), ivec2(0), last), 0).a);
    return max(d, texelFetch(historyTex, clamp(t + ivec2(1, 1), ivec2(0), last), 0).a);
}

//TaaMath.clip: the history pulled along the line to the box's centre until it lies inside
vec3 clipToBox(vec3 h, vec3 lo, vec3 hi) {
    vec3 centre = 0.5*(lo + hi);
    vec3 ext = max(0.5*(hi - lo), vec3(BOX_EPS));
    vec3 v = h - centre;
    vec3 a = abs(v)/ext;
    float units = max(a.x, max(a.y, a.z));
    return units > 1.0 ? centre + v/units : h;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(taaOut);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    ivec2 last = size - 1;
    vec3 current = texelFetch(currentTex, p, 0).rgb;

    //The pixel's own depth: stored for the next frame, and its class
    vec3 ownView;
    bool ownLod;
    bool ownGeometry = scenePositionFrom(p, size, ownView, ownLod);
    float ownDepth = ownGeometry ? min(-ownView.z, SKY_DEPTH) : SKY_DEPTH;//LODs past SKY_DEPTH count as sky (rgba16f range)
    if (taaParams.x < 0.5) {
        imageStore(taaOut, p, vec4(current, ownDepth));
        return;
    }

    //The 3x3 neighbourhood: colour statistics and the closest depth
    vec3 m1 = vec3(0.0), m2 = vec3(0.0), mn = vec3(1e9), mx = vec3(-1e9);
    float closest = 2.0;
    ivec2 closestAt = p;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            ivec2 q = clamp(p + ivec2(i, j), ivec2(0), last);
            vec3 c = toYCoCg(texelFetch(currentTex, q, 0).rgb);
            m1 += c;
            m2 += c*c;
            mn = min(mn, c);
            mx = max(mx, c);
            float d = texelFetch(mainDepth, q, 0).r;
            if (d < closest) {
                closest = d;
                closestAt = q;
            }
        }
    }

    //The motion of the closest surface (or the sky's direction) moves this pixel
    vec3 view;
    bool fromLod;
    bool geometry = scenePositionFrom(closestAt, size, view, fromLod);
    float w = 1.0;
    if (!geometry) {
        view = viewRay(invVanillaProj, pixelUvGl(closestAt, size));
        w = 0.0;
    }
    vec2 prevPos;
    float prevW;
    bool onScreen = reproject(view, w, size, prevPos, prevW);
    vec2 motion = prevPos - (vec2(closestAt) + 0.5);
    prevPos = vec2(p) + 0.5 + motion;
    onScreen = onScreen && all(greaterThanEqual(prevPos, vec2(0.0))) && all(lessThanEqual(prevPos, vec2(size)));
    float expected = geometry ? min(prevW, SKY_DEPTH) : SKY_DEPTH;
    if (!onScreen || historyMaxDepth(prevPos, size) < expected*(1.0 - DISOCCLUSION_DEPTH)) {
        imageStore(taaOut, p, vec4(current, ownDepth));
        return;
    }
    vec3 history = historyCatmullRom(prevPos, 1.0/vec2(size));
    if (any(isnan(history))) {
        imageStore(taaOut, p, vec4(current, ownDepth));
        return;
    }

    //Clip the history to the neighbourhood's variance box (within its min/max), per class
    bool translucent = texelFetch(opaqueDepth, p, 0).r > texelFetch(mainDepth, p, 0).r;
    bool isFar = ownLod || (ownGeometry && ownDepth > taaParams.y);
    float gamma = translucent ? TRANSLUCENT_CLIP_GAMMA : (isFar ? FAR_CLIP_GAMMA : CLIP_GAMMA);
    vec3 mean = m1/9.0;
    vec3 sigma = sqrt(max(m2/9.0 - mean*mean, vec3(0.0)));
    vec3 lo = max(mean - gamma*sigma, mn);
    vec3 hi = min(mean + gamma*sigma, mx);
    vec3 h = clipToBox(toYCoCg(history), lo, hi);

    float t = clamp(length(motion)/MOTION_RAMP_PIXELS, 0.0, 1.0);
    float weight = mix(CURRENT_WEIGHT, MOVING_CURRENT_WEIGHT, t);
    if (translucent) {
        weight = max(weight, TRANSLUCENT_CURRENT_WEIGHT);
    }
    vec3 result = fromYCoCg(mix(h, toYCoCg(current), weight));
    imageStore(taaOut, p, vec4(clamp(result, 0.0, 1.0), ownDepth));
}
