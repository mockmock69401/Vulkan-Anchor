#version 450
//Visuals P7e-1 (design 2026-10-11 P7e-1 3.2): vanilla's main depth copied as it is, right before and right after vanilla's
// translucent terrain, for lighting.comp to tell translucent surfaces apart.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, r32f) uniform writeonly restrict image2D depthOut;
layout(binding = 1) uniform sampler2D depthIn;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(depthOut)))) {
        return;
    }
    imageStore(depthOut, p, vec4(texelFetch(depthIn, p, 0).r));
}
