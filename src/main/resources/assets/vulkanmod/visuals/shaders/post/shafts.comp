#version 450
//Visuals light shafts (design 2026-10-10 P7c 3.3), at half resolution: MASK keeps the bright sky (the sun disc and its
// halo; anything that wrote depth blocks it), BLUR walks toward the sun's screen position (GPU Gems 3, ch. 13). 2026-11-22: at
// night the same toward the moon, with the mask's threshold and a window around the moon from params.zw (AtmosphereUniforms.writeShafts).
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform writeonly restrict image2D dst;
layout(binding = 1) uniform sampler2D src;
#ifdef MASK
layout(binding = 2) uniform sampler2D mainDepth;
#endif
layout(location = 0) uniform vec4 params;//light position (row 0 at the top), the mask's threshold (0: SHAFT_THRESHOLD), its window radius in screen heights (0: none)

#import <vulkanmod:visuals/util/depthutils.glsl>
#import <vulkanmod:visuals/post/postmath.glsl>
#import <vulkanmod:visuals/post/atmosphere.glsl>

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
#ifdef MASK
    //The composite writes depth for LODs too, so only the sky is left at the far plane. 2026-11-22: the mean of the 4x4 full-resolution
    // texels around this texel's 2x2 (one texel let TAA's sub-pixel jitter move a silhouette's edge a whole texel, and the beams' edges
    // flickered frame to frame)
    float threshold = params.z > 0.0 ? params.z : SHAFT_THRESHOLD;
    ivec2 full = textureSize(src, 0);
    float light = 0.0;
    for (int y = -1; y < 3; y++) {
        for (int x = -1; x < 3; x++) {
            ivec2 q = clamp(p*2 + ivec2(x, y), ivec2(0), full - 1);
            bool sky = texelFetch(mainDepth, q, 0).r == FAR;
            light += sky ? max(dot(texelFetch(src, q, 0).rgb, LUMA) - threshold, 0.0) : 0.0;
        }
    }
    light *= 1.0/16.0;
    if (params.w > 0.0) {
        vec2 d = ((vec2(p) + 0.5)/vec2(size) - params.xy)*vec2(float(size.x)/float(size.y), 1.0);
        light *= 1.0 - smoothstep(0.0, params.w, length(d));
    }
#else
    vec2 uv = (vec2(p) + 0.5)/vec2(size);
    vec2 here = uv;
    vec2 stepToSun = (uv - params.xy)/float(SHAFT_SAMPLES);
    float decay = 1.0;
    float light = 0.0;
    for (int i = 0; i < SHAFT_SAMPLES; i++) {
        uv -= stepToSun;
        light += texture(src, uv).r*decay;
        decay *= SHAFT_DECAY;
    }
    light /= float(SHAFT_SAMPLES);
    if (params.w > 0.0) {
        //The moon (2026-11-23): fading with the distance from it, and nothing over its disc and glow (atmosphere.glsl)
        vec2 d = (here - params.xy)*vec2(float(size.x)/float(size.y), 1.0);
        light *= 1.0 - smoothstep(0.0, params.w*MOON_SHAFT_REACH, length(d));
        light *= 1.0 - smoothstep(0.0, MOON_SHAFT_GLARE, texture(src, here).r);
    }
#endif
    imageStore(dst, p, vec4(light, 0.0, 0.0, 1.0));
}
