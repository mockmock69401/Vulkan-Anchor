#version 450
//W10: the ambient occlusion's depth- and normal-aware blur, one invocation per half-resolution texel (ao.glsl's header). Its
// (2 AO_BLUR_RADIUS + 1)^2 window covers the whole screen pattern of ao.comp, so every texel on a surface averages every rotation and
// step offset once: the pattern cancels instead of crawling. Plant and light-source texels take the ground around them, sky and
// translucent texels are 1 and nobody's neighbour. Writes r the visibility, g the view distance the composite's upsampling compares.
// AmbientOcclusion.blur mirrors it.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform writeonly restrict image2D aoOut;
layout(binding = 1) uniform sampler2D aoRaw;
layout(binding = 2) uniform sampler2D aoDepth;
layout(binding = 3) uniform sampler2D sunTex;

#import <vulkanmod:visuals/post/ao.glsl>

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(aoOut);
    if (any(greaterThanEqual(q, size))) {
        return;
    }
    float centre = texelFetch(aoRaw, q, 0).r;
    float dist = abs(texelFetch(aoDepth, q, 0).r);
    if (centre < 0.5*(AO_TAKE_NEIGHBOURS + AO_NONE)) {
        imageStore(aoOut, q, vec4(1.0, dist, 0.0, 0.0));
        return;
    }
    bool own = centre >= 0.0;
    //W5's normals are unit vectors stored at half precision: normalised here so the agreement is exact (own texels and the neighbours
    // counted, both with ao.comp's valid normal, never sky's 0)
    vec3 n = own ? normalize(texelFetch(sunTex, q, 0).gba) : vec3(0.0);
    float sum = 0.0;
    float weights = 0.0;
    for (int j = -AO_BLUR_RADIUS; j <= AO_BLUR_RADIUS; j++) {
        for (int i = -AO_BLUR_RADIUS; i <= AO_BLUR_RADIUS; i++) {
            ivec2 t = q + ivec2(i, j);
            if (any(lessThan(t, ivec2(0))) || any(greaterThanEqual(t, size))) {
                continue;
            }
            float v = texelFetch(aoRaw, t, 0).r;
            if (v < 0.0) {
                continue;
            }
            float ds = abs(texelFetch(aoDepth, t, 0).r);
            float w = exp(-abs(ds - dist)/(AO_BLUR_DEPTH_SHARE*dist + AO_BLUR_DEPTH_MIN));
            if (own) {
                w *= pow(max(dot(n, normalize(texelFetch(sunTex, t, 0).gba)), 0.0), AO_BLUR_NORMAL_POWER);
            }
            sum += v*w;
            weights += w;
        }
    }
    //An own centre always counts (its normal agrees with itself), so only a plant without ground around it falls back to 1
    float ao = weights > 1e-6 ? sum/weights : (own ? centre : 1.0);
    imageStore(aoOut, q, vec4(ao, dist, 0.0, 0.0));
}
