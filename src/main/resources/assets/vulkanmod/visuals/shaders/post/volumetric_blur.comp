#version 450
//W8: the shaft mask into the shaft image. A separable 5x5 filter whose two end taps (BLUR_EDGE) share a residue mod 4, so each
// texel of a 4x4 block weighs the same and volumetric.comp's ordered dither of the ray offsets averages out exactly on smooth areas.
// VolumetricMath mirrors it: change both together.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform writeonly restrict image2D dst;
layout(binding = 1) uniform sampler2D src;

const int BLUR_RADIUS = 2;
const float BLUR_EDGE = 0.125;
const float BLUR_INNER = 0.25;

float blurWeight(int i) {
    return abs(i) == BLUR_RADIUS ? BLUR_EDGE : BLUR_INNER;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    ivec2 srcSize = textureSize(src, 0);
    float sum = 0.0;
    for (int j = -BLUR_RADIUS; j <= BLUR_RADIUS; j++) {
        for (int i = -BLUR_RADIUS; i <= BLUR_RADIUS; i++) {
            ivec2 s = clamp(p + ivec2(i, j), ivec2(0), srcSize - 1);
            sum += blurWeight(i)*blurWeight(j)*texelFetch(src, s, 0).r;
        }
    }
    imageStore(dst, p, vec4(max(sum, 0.0), 0.0, 0.0, 1.0));
}
