#ifdef SUN_OPEN_PASS
//Session 14: the frame's sun open share, by one invocation (dispatched as one group), as compositeAt used to work it out per pixel
void main() {
    if (gl_LocalInvocationIndex != 0u) {
        return;
    }
    sunOpenShareValue = sunOpenShare(mainDepth, inverse(invVanillaProj), transpose(mat3(invView)), atmosphereSun.xyz, imageSize(sceneOut),
            sunExtent(celestial));
}
