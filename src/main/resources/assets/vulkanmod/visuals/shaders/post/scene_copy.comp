//Session 8 follow-up: a light source's glow in the colour of the light it casts (glowTint; the plain builds leave it)
vec3 tintedGlow(vec3 glow) {
#ifdef ATMOSPHERE_TINTS
    return glow*glowTint.rgb;
#else
    return glow;
#endif
}

