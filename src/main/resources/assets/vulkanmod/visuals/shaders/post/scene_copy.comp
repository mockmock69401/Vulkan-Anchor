#ifdef PARTICLE_PASS
//The tile: each pixel's composite (rgb) and whether nothing was drawn over it (w 1), and its colour before the particles
shared vec4 tileShown[COMPOSITE_TILE];
shared vec3 tileBehind[COMPOSITE_TILE];

//Session 14 follow-up (2026-11-12): the translucent particles laid over the background of their tile, after the composite (which drew
// each as an opaque surface at its own colour and flagged its tile): the steps the composite took in one pass with the tile in shared
// memory until then. That tile, its barrier and the loop cost every pixel of the composite 0.7 ms (11%) on an AMD iGPU at 1280x720 with
// no particle on screen. The tile's pixels are the composite's results read back (rgba16f); a particle pixel is never read by another,
// so the pass writes over the composite's image in place
void main() {
    if (particleTile[gl_WorkGroupID.y*gl_NumWorkGroups.x + gl_WorkGroupID.x] == 0u) {
        return;
    }
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(sceneOut);
    uint here = gl_LocalInvocationIndex;
    bool inside = all(lessThan(p, size));
    vec4 result = vec4(0.0);
    vec3 behind = vec3(0.0);
    bool overdrawn = false;
    float cover = 1.0;
    if (inside) {
        vec4 colour = texelFetch(mainColour, p, 0);
        behind = texelFetch(colourAfterTranslucent, p, 0).rgb;
        overdrawn = overdrawnAfterTranslucent(behind, colour.rgb);
        vec3 own;
        if (!(overdrawn && translucentParticle(p, colour.rgb, behind, own, cover))) {
            cover = 1.0;
        }
        result = imageLoad(sceneOut, p);
    }
    //Every invocation of a flagged tile reaches the barrier: the tile's composite where nothing was drawn over it
    tileShown[here] = vec4(result.rgb, inside && !overdrawn ? 1.0 : 0.0);
    tileBehind[here] = behind;
    barrier();
    if (!inside || !(cover < PARTICLE_COVER_OPAQUE)) {
        return;
    }
    vec3 sum = particleBehindGuess(p, size, behind)*PARTICLE_GUESS_WEIGHT;
    float weight = PARTICLE_GUESS_WEIGHT;
    for (uint i = 0u; i < COMPOSITE_TILE; i++) {
        vec4 t = tileShown[i];
        if (t.w > 0.5) {
            vec3 d = tileBehind[i] - behind;
            float w = exp(-dot(d, d)/(PARTICLE_BEHIND_MATCH*PARTICLE_BEHIND_MATCH));
            sum += t.rgb*w;
            weight += w;
        }
    }
    result.rgb = mix(sum/weight, result.rgb, cover);
    imageStore(sceneOut, p, result);
}
#else
//The composite: one pixel each. A translucent particle is composited as an opaque surface at its own colour and its tile flagged for
// the .PARTICLES pass, which lays it over its background
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(sceneOut);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    vec4 colour = texelFetch(mainColour, p, 0);
    vec3 behind = texelFetch(colourAfterTranslucent, p, 0).rgb;
    bool overdrawn = overdrawnAfterTranslucent(behind, colour.rgb);
    vec3 own;
    float cover;
    if (overdrawn && translucentParticle(p, colour.rgb, behind, own, cover)) {
        colour = vec4(own, 1.0);
        particleTile[gl_WorkGroupID.y*gl_NumWorkGroups.x + gl_WorkGroupID.x] = 1u;
    }
    imageStore(sceneOut, p, compositeAt(p, size, colour, overdrawn));
}
