//2026-11-09 (session 5): the aurora along a sky direction dir at pixel p (aurora.glsl, AURORA_STEPS samples from a per-pixel jitter
// that turns by the frame's phase with TAA); nothing evaluated without one (auroraParams.x 0: day, rain, off, the Nether)
vec3 auroraSky(vec3 dir, ivec2 p) {
    if (!(auroraParams.x > 0.0)) {
        return vec3(0.0);
    }
#ifdef ATMOSPHERE_TINTS
    return aurora(dir, auroraParams, auroraTintLow.rgb, auroraTintMid.rgb, auroraTintTop.rgb, AURORA_STEPS,
            fract(interleavedGradientNoise(vec2(p)) + auroraParams.w));
#else
    return aurora(dir, auroraParams, vec3(1.0), vec3(1.0), vec3(1.0), AURORA_STEPS, fract(interleavedGradientNoise(vec2(p)) + auroraParams.w));
#endif
}

//Vanilla's directional face shade in a dimension with sky light (ClientLevel.getShade: display values the terrain colour was multiplied
// with). W5's sun facing replaces it on the sky-lit light: it is divided out there, FACE_UNSHADE of it at full sun weight
const float FACE_SHADE_DOWN = 0.5;
const float FACE_SHADE_UP = 1.0;
const float FACE_SHADE_NORTH_SOUTH = 0.8;
const float FACE_SHADE_WEST_EAST = 0.6;
const float FACE_UNSHADE = 1.0;
//A normal counts as a block face when within acos(FACE_AXIS_MIN) of an axis (snapNormal gives exact axes; mobs keep their own shading)
const float FACE_AXIS_MIN = 0.999;
//The share of vanilla's face shade baked into Distant Horizons' LOD colours (1: as vanilla's terrain)
const float LOD_FACE_SHADE_SHARE = 1.0;
//B14: separate exposures. By day a camera without sky light (underground) sees sky-lit surfaces at UNDERGROUND_SKY_EXPOSURE (they do not
// jump brighter than the shade outside when the sun shading lets go); by day block light is seen at DAY_BLOCK_EXPOSURE wherever the camera
// is. The night's sky light takes NIGHT_SKY_EXPOSURE (tuning round 3, below). 2026-11-08 (the user: with the sun up the light of torches,
// furnaces and campfires got darker instead): 1, block light as bright by day as by night (tuning round 1 had 0.6 from refs/S8, a closed
// room at noon; skyLitShare already gives block light only what it adds to the sky's under the open sky)
const float UNDERGROUND_SKY_EXPOSURE = 0.7;
const float DAY_BLOCK_EXPOSURE = 1.0;
//Tuning round 1: dimensions without sky light (Nether, End: slot 29 .w NO_SKY) are seen at this exposure (refs/S9 is about 1.6, refs/S10
// about 1.9 of vanilla's light); light sources keep their brightness
const float NO_SKY_EXPOSURE = 1.7;
//Tuning round 2: with the camera under water the whole view is seen at UNDERWATER_EXPOSURE (refs/S5 is about 1.8, its darkest quarter
// 2.4 of vanilla's light). Final fix R2: under water is the camera's fluid (slot 29 .y: swamp and mangrove water too; lava, powder snow
// and a modded blue fog are not). 2026-11-09 (session 2b): 2 -> 1.3, on what the view shows only (the water's own colour and Snell's
// window take none): 2 lifted vanilla's fogged image; through the composite's water it lifted kelp and the floor to the water's own
// brightness, so they hardly stood out (Complementary Reimagined's are dark silhouettes), and a floor seen from just above the surface
// (no exposure) jumped brighter once the camera dipped under
const float UNDERWATER_EXPOSURE = 1.3;
//B3: vanilla's cloud layer (cloudShape x, y while the far clouds are off) widened by this many blocks plus a share of the distance
// (also for a flat layer of thickness 0, vanilla's fast clouds)
const float VANILLA_CLOUD_MARGIN = 0.5;
const float VANILLA_CLOUD_MARGIN_SHARE = 0.01;
//B3: the sky light a cell must hold to count as cloud air (clouds sit in open air)
const int VANILLA_CLOUD_SKY = 15;
//The held light's grid (HeldLight.SIDE) and how far it may lift a colour (HeldLight.MAX_GAIN)
const int HELD_GRID_SIDE = 31;
const float HELD_MAX_GAIN = 256.0;
//2026-10-31 (the user: a held torch as bright as a placed one): the held light loses HELD_FALLOFF levels per block of its way, as a placed
// torch's does (tuning rounds 1-3 had 1.7, to light only the surfaces near the hand). The grid's ways are in 1/HELD_DIST_STEPS blocks,
// HELD_UNREACHED where the light does not reach (HeldLight)
const float HELD_FALLOFF = 1.0;
const float HELD_DIST_STEPS = 8.0;
//The share of the grid's way counted: its 26-neighbour steps overestimate a straight way by up to about an eighth, which in open air
// would win over the straight line and bring the blocky way back
const float HELD_WAY_SHARE = 0.88;
const int HELD_UNREACHED = 255;
//2026-10-30: how far in front of a face its held light layer is read (SceneCompositeMath.HELD_FRONT_STEP): under half a block, so a
// face half a block into its cell (a slab's) stays on its own cell instead of a boundary where depth noise flipped it with the view
const float HELD_FRONT_STEP = 0.34375;
//Tuning round 3: the sky-lit light's weather and night exposures. Under an overcast day sky (W4's overcast share, Atmosphere.sunLight.w,
// 0.8 in full rain (slot 29 .z), times the day seen from under the open sky: slot 11 .w) it rises toward OVERCAST_EXPOSURE (refs/S4 lights rainy
// terrain about 3x vanilla: 1 + (3.6 - 1) x 0.8 = 3.1); at night (1 - slot 11 .z) it falls to NIGHT_SKY_EXPOSURE (refs/S3: the moonlit
// terrain was 1.34x; 2026-10-28: 0.7 left the moonlit terrain 0.77x Complementary Reimagined's, 0.85). Block light is not touched; without
// sky (slot 29 .w not ATMOSPHERE_SKY) and underground both are 1. 2026-10-28 (DeceasedCraft: rain and thunder too bright, the snow
// glaring, next to Oculus + Complementary Reimagined whose rainy street was 0.85x its clear one, ours 1.03x; 2.2 still 0.93x): 1.8, full
// rain 1.64x
const float OVERCAST_EXPOSURE = 1.8;
const float NIGHT_SKY_EXPOSURE = 0.85;
//Tuning round 3 (refs/S13): with the camera inside vanilla's cloud layer (cloudShape x below CLOUD_CAMERA_MARGIN and its top above
// -CLOUD_CAMERA_MARGIN) the far clouds start FAR_CLOUD_NEAR blocks out: the march from inside a cloud cell veiled every surface (a ray down
// crosses the cell around the camera), which vanilla does not show
const float FAR_CLOUD_NEAR = 16.0;
const float CLOUD_CAMERA_MARGIN = 1.0;
//2026-10-28 (the user: next to Complementary Reimagined the night's torch light looked like vanilla's): the block-lit light takes the
// warm colour at its own luminance (vanilla's lightmap is near white beside a torch) and falls off faster from the source, its
// luminance times (its block level's luminance / the full level's)^(BLOCK_LIGHT_FALLOFF x strength); per channel it is never lifted
// more than BLOCK_LIGHT_GAIN_MAX times. The falloff is measured from BLOCK_LIGHT_KNEE of the full level's luminance (about level 13 on
// vanilla's curve), so the light right at the source is lifted, up to (1/BLOCK_LIGHT_KNEE)^BLOCK_LIGHT_FALLOFF at full (the user: the
// centre looked darker than Complementary Reimagined's; there the torch-lit wall was 0.87x as bright)
const float BLOCK_LIGHT_FALLOFF = 1.0;
const float BLOCK_LIGHT_KNEE = 0.62;
const float BLOCK_LIGHT_GAIN_MAX = 16.0;
//2026-10-28 (the user: next to Complementary Reimagined lava, magma and ores glow): a light source's texel is multiplied by up to
// 1 + LIGHT_GLOW_GAIN x the block glow where its brightest channel (display) passes LIGHT_GLOW_LOW..LIGHT_GLOW_HIGH, so lava, magma's
// cracks and glowstone reach the tone curve's shoulder (yellower) and the bloom. An ore's specks add ORE_GLOW_LEVEL of their
// full-bright colour (the face's vanilla shade divided out, so every face glows alike) x the ore glow, whatever light reaches them.
// A speck is told from its host stone by the ore's own pixels about ORE_HOST_BLOCKS of a block around it (eight, the median of
// their vanilla colours: they share the light and the face shade): ORE_CONTRAST_LOW..HIGH times as bright (quartz in netherrack),
// or ORE_SAT_LOW..HIGH more saturated (iron, copper, gold, redstone, lapis in stone). 2026-10-28 (in game: white outlines around
// coal, redstone and nether gold, iron dark, copper and lower faces dull): the median, not the darkest, so stone beside a dark
// speck is no speck; saturation, not chroma, which the face shade scales
const float LIGHT_GLOW_GAIN = 3.0;
const float LIGHT_GLOW_LOW = 0.3;
const float LIGHT_GLOW_HIGH = 0.8;
//A light-emitting fluid (lava) glows this many times the block glow: one broad bright surface, it stayed orange at the block's gain
const float FLUID_GLOW_SCALE = 2.0;
//2026-11-08 (the user: a lit furnace's or a campfire's whole block shone, not only its fire): only a light source's bright texels are
// light, by the brightest channel of the texel's own colour (its albedo with vanilla's face shade divided out) from LIGHT_SOURCE_LOW (none)
// to LIGHT_SOURCE_HIGH (all, smoothstep); the rest is lit as any block. Vanilla's furnace, smoker and blast furnace stone, the campfire's
// bark and the lantern's frame reach 0.77, their fire 0.76..1. A light-emitting fluid (lava) is light all over
const float LIGHT_SOURCE_LOW = 0.78;
const float LIGHT_SOURCE_HIGH = 0.92;
const float ORE_GLOW_LEVEL = 0.8;
const float ORE_CONTRAST_LOW = 2.0;
const float ORE_CONTRAST_HIGH = 3.0;
const float ORE_SAT_LOW = 0.15;
const float ORE_SAT_HIGH = 0.3;
//2026-10-28 (in game, close: iron's grey rims and redstone's pink highlights went white): the brightness rule only where the host is
// coloured (netherrack, its median saturation ORE_HOST_SAT_LOW..HIGH); in grey stone and deepslate a speck is told by its colour
const float ORE_HOST_SAT_LOW = 0.2;
const float ORE_HOST_SAT_HIGH = 0.4;
const float ORE_HOST_MIN = 0.02;
//A pixel whose brightest channel (display) is below this is too dark to tell (a few 8-bit steps): no speck
const float ORE_VALUE_MIN = 0.03;
const float ORE_HOST_BLOCKS = 0.3;
const float ORE_HOST_STEP_MAX = 16.0;
//The face shade divided out is never taken below this
const float ORE_SHADE_MIN = 0.2;
//Without the albedo an ore's colour is vanilla's over vanilla's lightmap, only where the lightmap (display, brightest channel) is at
// least this: in the dark vanilla's colour is a few 8-bit steps and tells no speck from its host
const float ORE_LIGHTMAP_MIN = 0.15;
//Below this a lightmap difference counts as no light (the sky/block split)
const float LIGHT_SPLIT_MIN = 0.00001;
//B18: the light debug views (lightMode.x; 4 is W6's reflective view)
const int DEBUG_SKY_VIEW = 1;
const int DEBUG_BLOCK_VIEW = 2;
const int DEBUG_SHARE_VIEW = 3;
//2026-10-23: where each pixel's light came from: green the terrain light, blue the light volume, yellow the LOD pass, the unknown colour
const int DEBUG_SOURCE_VIEW = 5;
//The debug views' colour where the light is not known
const float DEBUG_UNKNOWN_RED = 0.25;
const float DEBUG_UNKNOWN_GREEN = 0.0;
const float DEBUG_UNKNOWN_BLUE = 0.25;

//Vanilla's lightmap (block light along u, sky light along v, display values) at fractional levels, in scene units
vec3 lightmapLinear(float block, float sky) {
    vec2 l = clamp(vec2(block, sky), 0.0, 15.0);
    return vanillaToScene(texture(lightmapTex, (l + 0.5)/16.0).rgb);
}

//The baked face shade (linear) for a world normal: block faces get getShade's value, anything else 1
float bakedShade(vec3 n) {
    vec3 a = abs(n);
    if (a.y >= FACE_AXIS_MIN) {
        return displayToLinear(n.y > 0.0 ? FACE_SHADE_UP : FACE_SHADE_DOWN);
    }
    if (a.z >= FACE_AXIS_MIN) {
        return displayToLinear(FACE_SHADE_NORTH_SOUTH);
    }
    if (a.x >= FACE_AXIS_MIN) {
        return displayToLinear(FACE_SHADE_WEST_EAST);
    }
    return 1.0;
}

//The factor that takes the face shade back out of the sky-lit light, by the sun weight (1 at weight 0)
float faceUnshade(float shade, float sunWeight) {
    return mix(1.0, 1.0/max(shade, 0.01), clamp(sunWeight, 0.0, 1.0)*FACE_UNSHADE);
}

//The sky-lit share of the light per channel: the lightmap's sky-only part against its combined colour (each above the dark floor), so
// block light only takes what it adds to the sky's (2026-10-22: a torch in daylight, where vanilla's lightmap is already full, took half
// the light to the lower day block exposure and darkened the sunlit ground)
vec3 skyLitShare(vec3 skyOnly, vec3 lightAll, vec3 dark) {
    vec3 s = max(skyOnly - dark, vec3(0.0));
    vec3 total = max(lightAll - dark, s);
    return mix(vec3(0.0), s/max(total, vec3(LIGHT_SPLIT_MIN)), greaterThan(total, vec3(LIGHT_SPLIT_MIN)));
}

//B15: the colour of the sky-lit light at luminance 1 (both colours are): the shade colour where only the sky reaches, the sun's colour
// where the sun does (W5's sunShare 0..1), mixed in by strength (light colour setting x the sun's weight; 0: white)
vec3 lightTint(float share, float strength, vec3 sunColour, vec3 shadeColour) {
    vec3 blend = mix(shadeColour, sunColour, clamp(share, 0.0, 1.0));
    return mix(vec3(1.0), blend, clamp(strength, 0.0, 1.0));
}

//2026-10-28: the moonlight's colour on the sky-lit light (slot 32: 0 strength by day; luminance 1, it moves the hue)
vec3 moonTint(vec4 moon) {
    return mix(vec3(1.0), moon.rgb, clamp(moon.w, 0.0, 1.0));
}

//2026-10-28: the factor per channel on the block-lit light blockLit (lightAll x its block-lit share): its colour moved toward warm (slot
// 31) at its luminance and its falloff steepened, by strength (0: 1). blockOnly and full are the lightmap at the block level alone and at
// level 15, dark the no-light floor. The colour and falloff take only the light above blockFloor (the floor's block-lit share): with no
// sky light all of a dimension's ambient light is block-lit, and the nether's went black (2026-10-28 nether shots)
vec3 blockLightFactor(vec3 blockLit, vec3 blockFloor, vec3 blockOnly, vec3 full, vec3 dark, vec3 warm, float strength) {
    float s = clamp(strength, 0.0, 1.0);
    vec3 above = max(blockLit - blockFloor, vec3(0.0));
    float l = luminance(above);
    if (s <= 0.0 || l <= LIGHT_SPLIT_MIN) {
        return vec3(1.0);
    }
    float level = clamp(luminance(max(blockOnly - dark, vec3(0.0)))/max(luminance(full - dark), LIGHT_SPLIT_MIN), 0.0, 1.0);
    vec3 target = blockLit - above + mix(above, l*warm, s)*pow(level/BLOCK_LIGHT_KNEE, BLOCK_LIGHT_FALLOFF*s);
    return min(target/max(blockLit, vec3(LIGHT_SPLIT_MIN)), vec3(BLOCK_LIGHT_GAIN_MAX));
}

//2026-10-28: a light source's gain on its texel colour (display values) at the block glow strength
float lightGlow(vec3 colour, float strength) {
    return 1.0 + LIGHT_GLOW_GAIN*max(strength, 0.0)*smoothstep(LIGHT_GLOW_LOW, LIGHT_GLOW_HIGH, max(colour.r, max(colour.g, colour.b)));
}

//2026-11-08: vanilla's face shade (display values, ClientLevel.getShade) of a world normal: bakedShade before its conversion to linear
float faceShadeDisplay(vec3 n) {
    vec3 a = abs(n);
    if (a.y >= FACE_AXIS_MIN) {
        return n.y > 0.0 ? FACE_SHADE_UP : FACE_SHADE_DOWN;
    }
    if (a.z >= FACE_AXIS_MIN) {
        return FACE_SHADE_NORTH_SOUTH;
    }
    if (a.x >= FACE_AXIS_MIN) {
        return FACE_SHADE_WEST_EAST;
    }
    return 1.0;
}

//2026-11-08: the share of a light source's texel that is light (0: lit as any block, 1: its glow alone). base: the texel's colour before the
// lightmap (display values, vanilla's face shade in it), n: the world normal of its face
float lightSourceShare(vec3 base, vec3 n) {
    return smoothstep(LIGHT_SOURCE_LOW, LIGHT_SOURCE_HIGH, max(base.r, max(base.g, base.b))/faceShadeDisplay(n));
}

//2026-10-28: a colour's saturation (display values), 0 grey .. 1 a pure hue; the face shade and the light's brightness leave it
float saturation(vec3 c) {
    float m = max(c.r, max(c.g, c.b));
    return m > 0.0 ? (m - min(c.r, min(c.g, c.b)))/m : 0.0;
}

//2026-10-28: the lower median of the first n values
float lowerMedian(float v[8], int n) {
    int k = (n - 1)/2;
    float best = v[0];
    for (int i = 0; i < n; i++) {
        int below = 0;
        int same = 0;
        for (int j = 0; j < n; j++) {
            below += v[j] < v[i] ? 1 : 0;
            same += v[j] == v[i] ? 1 : 0;
        }
        if (below <= k && below + same > k) {
            best = v[i];
        }
    }
    return best;
}

//2026-10-28: how much an ore pixel with vanilla colour own is a speck, against the ore's own pixels stride around it (straight and
// diagonal; none: no speck)
float oreSpeckAt(ivec2 p, ivec2 size, vec3 own, int stride) {
    if (max(own.r, max(own.g, own.b)) < ORE_VALUE_MIN) {
        return 0.0;
    }
    float lums[8];
    float sats[8];
    int n = 0;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            if (i == 0 && j == 0) {
                continue;
            }
            vec4 c = texelFetch(mainColour, clamp(p + stride*ivec2(i, j), ivec2(0), size - 1), 0);
            if (alphaCode(c.a) == ORE_ALPHA_CODE) {
                lums[n] = luminance(c.rgb);
                sats[n] = saturation(c.rgb);
                n++;
            }
        }
    }
    if (n == 0) {
        return 0.0;
    }
    float contrast = luminance(own)/max(lowerMedian(lums, n), ORE_HOST_MIN);
    float hostSat = lowerMedian(sats, n);
    float satDiff = saturation(own) - hostSat;
    return max(smoothstep(ORE_CONTRAST_LOW, ORE_CONTRAST_HIGH, contrast)*smoothstep(ORE_HOST_SAT_LOW, ORE_HOST_SAT_HIGH, hostSat),
            smoothstep(ORE_SAT_LOW, ORE_SAT_HIGH, satDiff));
}

//2026-10-28: the pixels ORE_HOST_BLOCKS of a block covers at view distance dist (vanilla's projection), 1..ORE_HOST_STEP_MAX
int oreHostStep(ivec2 size, float dist) {
    float pixelsPerBlock = 0.5*float(size.y)/max(abs(invVanillaProj[1][1])*dist, 0.0001);
    return int(clamp(ORE_HOST_BLOCKS*pixelsPerBlock, 1.0, ORE_HOST_STEP_MAX) + 0.5);
}

//2026-10-28: the light an ore texel adds (scene units) at the ore glow strength: its colour (display) with the face's vanilla shade
// (bakedShade, linear) divided out, never above white
vec3 oreGlow(vec3 base, float speck, float shade, float strength) {
    vec3 full = min(vanillaToScene(base)/max(shade, ORE_SHADE_MIN), vanillaToScene(vec3(1.0)));
    return full*ORE_GLOW_LEVEL*speck*max(strength, 0.0);
}

//Final fix R1: the look weight every added exposure is blended toward 1 by (W4's slot 29 .x)
float lookWeight() {
    return clamp(lookParams.x, 0.0, 1.0);
}

//An exposure as applied: mix(1, e, look)
float looked(float e, float look) {
    return mix(1.0, e, clamp(look, 0.0, 1.0));
}

//B14: the sky-lit light's exposure from the sun-up factor and that times the camera's sky exposure (slot 11 z, w)
float skyExposure(float sunUp, float sunUpExposed, float look) {
    return 1.0 - clamp(sunUp - sunUpExposed, 0.0, 1.0)*(1.0 - looked(UNDERGROUND_SKY_EXPOSURE, look));
}

//Tuning round 3: the sky-lit light's weather (overcast day) and night exposure; overcast the overcast share (slot 29 .z)
float skyWeatherExposure(float overcast, float sunUp, float sunUpExposed, float look) {
    float o = clamp(overcast, 0.0, 1.0)*clamp(sunUpExposed, 0.0, 1.0);
    return mix(1.0, looked(OVERCAST_EXPOSURE, look), o)*mix(1.0, looked(NIGHT_SKY_EXPOSURE, look), 1.0 - clamp(sunUp, 0.0, 1.0));
}

//Where the far clouds start along a view: FAR_CLOUD_NEAR with the camera inside vanilla's cloud layer, else at the camera
float farCloudNear() {
    return cloudShape.x < CLOUD_CAMERA_MARGIN && cloudShape.x + cloudShape.y > -CLOUD_CAMERA_MARGIN ? FAR_CLOUD_NEAR : 0.0;
}

//B14: the block light's exposure from the sun-up factor (slot 11 z)
float blockExposure(float sunUp, float look) {
    return 1.0 - clamp(sunUp, 0.0, 1.0)*(1.0 - looked(DAY_BLOCK_EXPOSURE, look));
}

//The view's exposure with the camera inside water (slot 29 .y, the camera's fluid), else 1
float underwaterExposure() {
    return lookParams.y > 0.5 ? looked(UNDERWATER_EXPOSURE, lookWeight()) : 1.0;
}

//2026-11-09 (session 2b): the camera is inside water (slot 29 .y) and the composite draws the water (slot 35 .y above 0: fog strength
// above 0; at 0 the view is as vanilla's water fog leaves it)
bool cameraUnderwater() {
    return lookParams.y > 0.5 && underwaterParams.y > 0.0;
}

//2026-11-09 (fix session after 2b): the pixel a direction from the camera (world) lands on, and how much a lookup there counts
// (underwaterEdgeFade: 0 off the screen or behind the camera)
ivec2 underwaterPixelOf(vec3 worldDir, ivec2 size, out float fade) {
    vec2 uv = underwaterScreenOf(transpose(mat3(invView))*worldDir, invVanillaProj[0][0], invVanillaProj[1][1]);
    fade = underwaterEdgeFade(uv);
    return clamp(ivec2(floor(vec2(uv.x, 1.0 - uv.y)*vec2(size))), ivec2(0), size - 1);
}

//Where the depth before the translucent terrain (binding 17) puts pixel q, camera-relative (world, blocks), when it lies on the asked
// side of the water's surface above (above: behind the surface, within UNDERWATER_LAND_MAX past it; else under the water, in front
// of the surface); false for the sky, the other side, or no copy this frame
bool underwaterSideAt(ivec2 q, ivec2 size, bool above, out vec3 at) {
    at = vec3(0.0);
    if (underwaterLight.w < 0.5) {
        return false;
    }
    float depth = texelFetch(beforeTranslucent, q, 0).r;
    if (depth == FAR) {
        return false;
    }
    at = mat3(invView)*viewPosition(invVanillaProj, pixelUvGl(q, size), depth);
    float dist = length(at);
    vec3 dirQ = at/max(dist, 1e-6);
    float tq = underwaterSurfaceDistance(underwaterParams.x, dirQ);
    if (!underwaterThroughSurface(underwaterParams.x, tq, dirQ.y, dist, false)) {
        return !above;
    }
    return above && dist - tq < UNDERWATER_LAND_MAX;
}

//What the screen shows along the ray leaving the surface at `from` (camera-relative, blocks) in direction ray, on the asked side of the
// surface (underwaterSideAt): the pixel of the ray's direction from the camera, then the pixel of the point as far along the ray as what
// that one shows. Returns the lookup's weight (0: nothing found), with vanilla's colour there (scene units) and its distance from `from`
float underwaterLookup(vec3 from, vec3 ray, bool above, ivec2 size, out vec3 colour, out float path) {
    colour = vec3(0.0);
    path = 0.0;
    float fade;
    vec3 at;
    ivec2 q = underwaterPixelOf(ray, size, fade);
    if (fade <= 0.0 || !underwaterSideAt(q, size, above, at)) {
        return 0.0;
    }
    q = underwaterPixelOf(from + ray*max(length(at - from), UNDERWATER_LOOKUP_MIN), size, fade);
    if (fade <= 0.0 || !underwaterSideAt(q, size, above, at)) {
        return 0.0;
    }
    colour = vanillaToScene(texelFetch(mainColour, q, 0).rgb);
    path = length(at - from);
    return fade;
}

//2026-11-09 (session 2b): pixel p seen from inside water along dir (world), dist blocks away (sky: nothing in front), showing `shown`
// (scene units, at the underwater exposure): through the water between (underwaterMedium) or, where the view rises to the surface,
// Snell's window (underwaterWindow) onto the air's sky and the land along the refracted view, and past the critical angle the water
// below mirrored along the reflected view (fix session after 2b: both looked up on the screen, underwater.glsl's header)
vec3 underwaterView(ivec2 p, ivec2 size, vec3 dir, float dist, bool sky, vec3 shown) {
    float surfaceUp = underwaterParams.x;
    float h0 = max(surfaceUp, 0.0);
    vec3 light = underwaterLight.rgb;
    float visibility = underwaterParams.y;
    float t = underwaterSurfaceDistance(surfaceUp, dir);
    if (!underwaterThroughSurface(surfaceUp, t, dir.y, dist, sky)) {
        //Without an open surface above, the water does not brighten upward
        return underwaterMedium(shown, sky ? UNDERWATER_LONGEST : dist, surfaceUp > 0.0 ? dir.y : min(dir.y, 0.0), h0, light, visibility);
    }
    //The rippled surface where the view meets it, faded by the blocks one pixel covers there (W5's blocks per pixel, foreshortened)
    float focal = 0.5*float(size.y)/max(abs(invVanillaProj[1][1]), 0.000001);
    float footprint = t/focal/max(dir.y, RIPPLE_MIN_COS);
    vec3 n = rippleNormal(dir.xz*t, underwaterRippleA, underwaterRippleB, underwaterParams.z, underwaterParams.w, footprint);
    vec3 r = underwaterRefract(dir, n);
    vec3 from = dir*t;
    vec3 found;
    float path;
    vec3 above = vec3(0.0);
    if (dot(r, r) > 0.5) {
        //The air's sky along the refracted view, or (no sky light) vanilla's own pixel; the land above where the screen has it
        Atmosphere air = Atmosphere(airSun, airSunLight, airMoonLight, airDepth, airAmbient, airGlow, airFog, airFogTint, airOvercastTint, airMoonTint);
        above = atmosphereSky(air) ? skyColour(air, r) + sunGlow(air, r) + sunDisc(air, r, celestial) : vanillaToScene(texelFetch(mainColour, p, 0).rgb);
        above += auroraSky(r, p);
        float w = underwaterLookup(from, r, true, size, found, path);
        above = mix(above, found, w);
    }
    float w = underwaterLookup(from, reflect(dir, -n), false, size, found, path);
    vec3 below = underwaterMirrored(dir, n, found*underwaterExposure(), path, w, light, visibility);
    return underwaterMedium(underwaterWindow(dir, n, above, below), t, dir.y, h0, light, visibility);
}

//The mode the exposures follow (slot 29 .w: W4's mode as if the atmosphere were drawn)
bool exposureMode(float mode) {
    return abs(lookParams.w - mode) < 0.5;
}

//HeldLight.whiteSurfaceScale: the scale on a held gain (largest channel gainMax) so a colour (largest channel litMax) ends at most at
// the held light's lightmap colour (largest channel heldMax), and never darker than it was
float heldRoom(float litMax, float gainMax, float heldMax) {
    float room = max(heldMax/max(litMax, 1e-4), 1.0);
    return min(1.0, room/gainMax);
}

//The held grid's way at cell c (x fastest, then y, then z: HeldLight.index), HELD_UNREACHED outside it
int heldCell(ivec3 c) {
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(HELD_GRID_SIDE)))) {
        return HELD_UNREACHED;
    }
    uint i = uint(c.x + HELD_GRID_SIDE*(c.y + HELD_GRID_SIDE*c.z));
    return int((heldLight[i >> 2u] >> ((i & 3u)*8u)) & 0xFFu);
}

//B16, 2026-10-31 (the user: the held light moved in block steps and banded at block edges): the held level at a face (rel: the surface
// relative to the light volume's camera block corner, n its world normal). Its way from the eye: the straight line where the grid's way
// (the layer of cells HELD_FRONT_STEP in front of the face, bilinear, skipping cells the light does not reach) from the eye's cell centre,
// less the eye's offset from that centre, is no longer, which is open air; the grid's way round a wall where it is. The eye's exact
// position comes each frame, so the light follows it between the grid's spreads (SceneCompositeMath.heldPath, heldLevel)
float heldLevelAt(vec3 rel, vec3 n) {
    vec3 g = rel - heldOrigin.xyz;
    vec3 a = abs(n);
    int axis = a.x >= a.y && a.x >= a.z ? 0 : (a.y >= a.z ? 1 : 2);
    int u = axis == 0 ? 1 : 0;
    int v = axis == 2 ? 1 : 2;
    int layer = int(floor(g[axis] + (n[axis] >= 0.0 ? HELD_FRONT_STEP : -HELD_FRONT_STEP)));
    vec2 q = vec2(g[u], g[v]) - 0.5;
    vec2 f = floor(q);
    vec2 t = q - f;
    float sum = 0.0;
    float weights = 0.0;
    float nearest = 1e9;
    for (int i = 0; i < 4; i++) {
        ivec3 c = ivec3(0);
        c[axis] = layer;
        c[u] = int(f.x) + (i & 1);
        c[v] = int(f.y) + ((i >> 1) & 1);
        int way = heldCell(c);
        if (way >= HELD_UNREACHED) {
            continue;
        }
        float w = ((i & 1) != 0 ? t.x : 1.0 - t.x)*(((i >> 1) & 1) != 0 ? t.y : 1.0 - t.y);
        sum += float(way)*w;
        weights += w;
        nearest = min(nearest, float(way));
    }
    if (nearest > 1e8) {
        return 0.0;
    }
    float geo = (weights > 1e-6 ? sum/weights : nearest)/HELD_DIST_STEPS;
    vec3 eye = heldEye.xyz - heldOrigin.xyz;
    vec3 centre = vec3(float(HELD_GRID_SIDE/2) + 0.5);
    float path = max(distance(g, eye), geo*HELD_WAY_SHARE - distance(eye, centre));
    return max(heldEye.w - HELD_FALLOFF*path, 0.0);
}

//The light volume's horizontal reach from the camera in blocks (its ring of sections around the camera's section)
float volumeReach() {
    return floor(lightSize.x*0.5)*16.0;
}

//B3: a pixel of vanilla's own cloud layer. Only while vanilla draws it (the far clouds off: cloudShape.w 0) and W4 gives the layer
// (cloudShape x the bottom, y the thickness, 0 for flat clouds; all 0: no layer), within the layer's height, and only where the light
// volume says the cell half a block behind the surface is open air under the sky (sky light VANILLA_CLOUD_SKY): a block face has its block
// behind it. Where the volume does not know the cell, only beyond the volume's reach (vanilla terrain there is not drawn); without the
// light volume nothing is taken for a cloud (it cannot be told from terrain at the layer's height)
bool vanillaCloud(vec3 world, vec3 dir, float dist) {
    if (cloudShape.w > 0.5 || !(cloudShape.y > 0.0 || cloudShape.x != 0.0) || lightCamera.w < 0.5) {
        return false;
    }
    float margin = VANILLA_CLOUD_MARGIN + VANILLA_CLOUD_MARGIN_SHARE*dist;
    if (world.y < cloudShape.x - margin || world.y > cloudShape.x + max(cloudShape.y, 0.0) + margin) {
        return false;
    }
    int behind = lightByte(ivec3(lightCamera.xyz) + ivec3(floor(lightFrac.xyz + world + dir*0.5)));
    if (behind < 0) {
        return max(abs(world.x), abs(world.z)) > volumeReach();
    }
    return (behind & 15) >= VANILLA_CLOUD_SKY;
}

//The far cloud layer in front of maxDist along dir (W4's cloudOver of clouds.glsl's march, premultiplied and hazed), over colour;
// p the pixel (session 3: the realistic style's per-pixel jitter)
//Session 14 follow-up: a half-size texel's value at full-size pixel p, bilinear over the four nearest texels and weighed down by how far
// each texel's view distance lies from the pixel's own (no cloud from the sky behind a hill's edge on the hill, and none of the hill's on the
// sky); where all four lie elsewhere, the nearest in distance
const float HALF_SKY_DEPTH_SHARPNESS = 16.0;
//rgba16f holds up to 65504: the sky's distance (HAZE_MAX_DISTANCE) is stored as this
const float HALF_SKY_FAR = 60000.0;
//The half-size pass marches the aurora along two directions with the full size's samples each
const int HALF_SKY_AURORA_STEPS = AURORA_STEPS;
vec4 halfSkyAt(bool aurora, ivec2 p, float dist) {
    dist = min(dist, HALF_SKY_FAR);
    ivec2 hs = imageSize(skyHalfCloud);
    vec2 h = (vec2(p) + 0.5)*0.5 - 0.5;
    ivec2 b = ivec2(floor(h));
    vec2 f = h - vec2(b);
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    vec4 nearestValue = vec4(0.0);
    float nearestGap = 1e30;
    for (int i = 0; i < 4; i++) {
        ivec2 o = ivec2(i & 1, i >> 1);
        ivec2 c = clamp(b + o, ivec2(0), hs - 1);
        float dc = imageLoad(skyHalfAurora, c).w;
        vec4 v = aurora ? vec4(imageLoad(skyHalfAurora, c).rgb, 0.0) : imageLoad(skyHalfCloud, c);
        float gap = abs(dc - dist)/max(dist, 1.0);
        float w = (o.x == 1 ? f.x : 1.0 - f.x)*(o.y == 1 ? f.y : 1.0 - f.y)/(1.0 + HALF_SKY_DEPTH_SHARPNESS*gap);
        sum += v*w;
        wsum += w;
        if (gap < nearestGap) {
            nearestGap = gap;
            nearestValue = v;
        }
    }
    return wsum > 1e-4 ? sum/wsum : nearestValue;
}

//Session 14 follow-up: the aurora on a sky pixel (the half-size one with Half-resolution Weather & Sky)
vec3 auroraScreen(vec3 dir, ivec2 p) {
    if (halfParams.y > 0.5) {
        return auroraParams.x > 0.0 ? halfSkyAt(true, p, HAZE_MAX_DISTANCE).rgb : vec3(0.0);
    }
    return auroraSky(dir, p);
}

vec3 farCloudsOver(Atmosphere a, vec3 colour, vec3 dir, float maxDist, ivec2 p) {
    if (cloudShape.w < 0.5 || !atmosphereSky(a)) {
        return colour;
    }
    float near = farCloudNear();
    if (!(maxDist > near)) {
        return colour;
    }
    vec4 m;
    if (halfParams.x > 0.5) {
        //Session 14 follow-up: the half-size march (its distances already from the camera)
        m = halfSkyAt(false, p, maxDist);
    } else {
        m = farCloudMarch(dir*near, dir, maxDist - near, cloudLightDir.xyz, interleavedGradientNoise(vec2(p)));
        m.w += near;//the march's distances are from its start
    }
    if (!(m.z > 0.0)) {
        return colour;//no cloud in front: no haze to evaluate
    }
    vec4 r = cloudOver(a, CloudLight(cloudLit, cloudAmbient, cloudLightDir), m, dir, 1.0);
    return colour*(1.0 - r.a) + r.rgb;
}

//2026-10-21 (CTE2: light dots and dashes on far water): vanilla's water texture has bright streaks, which under the water colour and the
// reflection stood out where a texel is about a pixel. A vanilla water pixel takes up to WATER_FLATTEN of the mean of its eight
// neighbours WATER_FLATTEN_RADIUS pixels away that lie on the same surface (view distance within WATER_SAME_SURFACE of its own), fading
// in from WATER_FLATTEN_NEAR to WATER_FLATTEN_FAR blocks (near water keeps its texture). 2026-10-28 (the user: next to Complementary
// Reimagined the lakes were opaque): 0.75 two pixels out also blurred the floor seen through the water; 0.4 one pixel out
const float WATER_FLATTEN = 0.4;
const int WATER_FLATTEN_RADIUS = 1;
const float WATER_SAME_SURFACE = 0.03;
const float WATER_FLATTEN_NEAR = 24.0;
const float WATER_FLATTEN_FAR = 64.0;

vec3 flattenWaterTexture(ivec2 p, ivec2 size, vec3 scene, float dist) {
    float w = WATER_FLATTEN*smoothstep(WATER_FLATTEN_NEAR, WATER_FLATTEN_FAR, dist);
    if (w <= 0.0) {
        return scene;
    }
    vec3 sum = scene;
    float n = 1.0;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            if (i == 0 && j == 0) {
                continue;
            }
            ivec2 q = clamp(p + ivec2(i, j)*WATER_FLATTEN_RADIUS, ivec2(0), size - 1);
            float d = texelFetch(mainDepth, q, 0).r;
            if (d == FAR || abs(length(viewPosition(invVanillaProj, pixelUvGl(q, size), d)) - dist) > WATER_SAME_SURFACE*dist) {
                continue;
            }
            sum += vanillaToScene(texelFetch(mainColour, q, 0).rgb);
            n += 1.0;
        }
    }
    return mix(scene, sum/n, w);
}

//2026-10-21 (CTE2: with the LODs off the terrain ended against the sky; NoFog and DH both take vanilla's fog away): with no LODs drawn
// a vanilla surface fades into the sky behind it over the last part of the render distance, by its horizontal distance
float borderAmount(vec3 world, bool fromLod) {
    if (borderFog.z < 0.5 || fromLod) {
        return 0.0;
    }
    return smoothstep(borderFog.x, borderFog.y, length(world.xz));
}

//B18: a light debug view (1 sky light, 2 block light, 3 the light's shares: red direct sun, green block light, blue sky shade)
vec3 debugView(int view, bool known, float sky, float block, vec3 share, float sunPart) {
    if (!known) {
        return vec3(DEBUG_UNKNOWN_RED, DEBUG_UNKNOWN_GREEN, DEBUG_UNKNOWN_BLUE);
    }
    if (view == DEBUG_SKY_VIEW) {
        return vec3(displayToLinear(clamp(sky/15.0, 0.0, 1.0)));
    }
    if (view == DEBUG_BLOCK_VIEW) {
        return vec3(displayToLinear(clamp(block/15.0, 0.0, 1.0)));
    }
    float s = luminance(share);
    float sun = s*clamp(sunPart, 0.0, 1.0);
    return vec3(sun, 1.0 - s, s - sun);
}

//2026-10-23, debug view 5: where the light came from (source: pixelLight's z; albedo: the pixel also has its albedo)
vec3 sourceView(float source, bool fromLod, bool albedo) {
    if (source < 0.5) {
        return vec3(DEBUG_UNKNOWN_RED, DEBUG_UNKNOWN_GREEN, DEBUG_UNKNOWN_BLUE);
    }
    if (source > 1.5) {
        return albedo ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 1.0, 1.0);
    }
    return fromLod ? vec3(1.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
}

//2026-10-23, the albedo (terrain_light.glsl packs it, TerrainLightMath mirrors it): rgb, the depth step's low bits, written on top
const uint TERRAIN_ALBEDO_WRITTEN = 2147483648u;
const uint TERRAIN_ALBEDO_TAG_MASK = 63u;

//The colour before the lightmap (display values) of the fragment the terrain light holds here, when that fragment wrote it (opaque,
// unfogged); a farther fragment's that landed last carries another depth tag
bool terrainAlbedoAt(ivec2 p, out vec3 albedo) {
    uint v = imageLoad(terrainLight, p).r;
    uint a = imageLoad(terrainAlbedo, p).r;
    albedo = vec3(float(a & 255u), float((a >> 8) & 255u), float((a >> 16) & 255u))/255.0;
    return a >= TERRAIN_ALBEDO_WRITTEN && ((a >> 24) & TERRAIN_ALBEDO_TAG_MASK) == ((v >> 12) & TERRAIN_ALBEDO_TAG_MASK);
}

//Vanilla's lightmap colour at fractional levels as vanilla multiplies it (display values)
vec3 lightmapDisplay(float block, float sky) {
    vec2 l = clamp(vec2(block, sky), 0.0, 15.0);
    return texture(lightmapTex, (l + 0.5)/16.0).rgb;
}

//2026-10-23 (CTE2: grass block edges flickered between green and dirt): an albedo is only the pixel's when it times vanilla's lightmap
// at the stored levels gives the colour vanilla drew there (per channel within ABS + REL of it). Coplanar layers (the grass side's
// overlay over the dirt), a farther fragment that wrote last, and decals, outlines or shadows drawn over a surface fail it
const float TERRAIN_ALBEDO_MATCH_ABS = 0.03;
const float TERRAIN_ALBEDO_MATCH_REL = 0.12;

bool albedoMatches(vec3 albedo, vec3 vanilla, float block, float sky) {
    vec3 d = abs(albedo*lightmapDisplay(block, sky) - vanilla);
    return all(lessThanEqual(d, vec3(TERRAIN_ALBEDO_MATCH_ABS) + TERRAIN_ALBEDO_MATCH_REL*vanilla));
}

//2026-10-28 (the user: fog by the weather, as Oculus + Complementary Reimagined): in rain surfaces under the sky fade by distance
// (borderFog.w, AtmosphereUniforms.weatherFog), whatever the camera's height, into the horizon's fog colour tinted with vanilla's
// fog hue (the biome's blue-grey, as Complementary's rain fog; vanilla's own brightness went navy in thunder). Gaussian in
// distance: the street nearby stays clear, a hundred blocks away 70% is fog. The sky is left alone (and vanilla's clouds)
vec3 weatherFogOver(Atmosphere a, vec3 lit, vec3 dir, float dist, float amount) {
    if (!(borderFog.w > 0.0) || !atmosphereSky(a)) {
        return lit;
    }
    vec3 rainFog = fogColour(a, dir);
    float vl = luminance(vanillaFog.rgb);
    if (vanillaFog.w > 0.5 && vl > 1e-4) {
        rainFog = vanillaFog.rgb*(luminance(rainFog)/vl);
    }
    float k = borderFog.w*min(dist, HAZE_MAX_DISTANCE);
    return mix(rainFog, lit, exp(-k*k*amount));
}

//The composite of one pixel (main): colour is vanilla's there (or, for a translucent particle, its own colour, translucentParticle),
// overdrawn whether something was drawn over the translucent terrain there (overdrawnAfterTranslucent); rgb the scene, a the mark
vec4 compositeAt(ivec2 p, ivec2 size, vec4 colour, bool overdrawn) {
    vec3 scene = vanillaToScene(colour.rgb);
    Atmosphere a = Atmosphere(atmosphereSun, atmosphereSunLight, atmosphereMoonLight, atmosphereDepth, atmosphereAmbient, atmosphereGlow, atmosphereFog,
            atmosphereFogTint, atmosphereOvercastTint, atmosphereMoonTint);
    mat3 toWorld = mat3(invView);
    vec3 view;
    bool fromLod;
    if (!scenePositionFrom(p, size, view, fromLod)) {
        //Sky: W4's sky and glow, W6's disc, vanilla's stars and moon through W4, then the far clouds (they cover the disc). Without an
        // atmosphere, and without sky light (B17: no sun or sky effects; the End keeps its sky box), the game's pixel. 2026-11-09
        // (session 2b): from inside water nothing in front: the water itself, or Snell's window where the view rises to the surface
        if (cameraUnderwater()) {
            vec3 skyDir = normalize(toWorld*viewRay(invVanillaProj, pixelUvGl(p, size)));
            return vec4(underwaterView(p, size, skyDir, UNDERWATER_LONGEST, true, vec3(0.0)), 0.0);
        }
        vec3 dir = normalize(toWorld*viewRay(invVanillaProj, pixelUvGl(p, size)));
        if (!atmosphereOn(a) || abs(a.sun.w - ATMOSPHERE_NO_SKY) < 0.5) {
            return vec4((scene + auroraScreen(dir, p))*underwaterExposure(), 0.0);
        }
        //Session 5: the round discs (the round moon replaces vanilla's square one, which vanillaMoonKept drops) and the aurora, under
        // the far clouds
        //Session 12: the picked star colour on the stars (the .TINTED build)
        vec3 stars = vanillaStars(a, dir, scene, vanillaSky, vanillaFog, starGate)*vanillaMoonKept(a, dir, celestial);
#ifdef ATMOSPHERE_TINTS
        stars *= vanillaStarTint(a, dir, starTint);
#endif
        vec3 sky = skyColour(a, dir) + sunGlow(a, dir) + sunDisc(a, dir, celestial) + moonDisc(a, dir, celestial) + stars + auroraScreen(dir, p);
        return vec4(farCloudsOver(a, sky, dir, HAZE_MAX_DISTANCE, p)*underwaterExposure(), 0.0);
    }
    float dist = length(view);
    vec3 world = toWorld*view;
    vec3 dir = world/max(dist, 0.000001);
    bool passRan = lighting.z > 0.5;
    float look = lookWeight();
    bool plant = isPlant(colour.a);
    bool emissive = isEmissive(colour.a);
    bool ore = alphaCode(colour.a) == ORE_ALPHA_CODE;
    bool cloud = !fromLod && vanillaCloud(world, dir, dist);
    //The pixel's own normal, made as W5's pass makes it (lightingAt's normal); none for plants and clouds (2026-11-08: light sources have
    // one: their texels that are no light are lit as any block)
    vec3 east = vec3(invView[0][0], invView[1][0], invView[2][0]);
    vec3 up = vec3(invView[0][1], invView[1][1], invView[2][1]);
    vec3 normalView = vec3(0.0);
    if (fromLod) {
        normalView = lodFaceNormal(texelFetch(lodLight, lodTexel(p, size), 0).r, east, up);
    } else if (!plant && !cloud) {
        normalView = snapNormal(depthNormal(mainDepth, invVanillaProj, p, size, view), east, up);
    }
    vec3 normalWorld = toWorld*normalView;
    //W5's lighting, read only when the pass ran (slot 10 .z)
    vec4 lt = vec4(1.0, 1.0, 0.0, 1.0);
    float plantSun = -1.0;
    if (passRan) {
        lt = lightingAt(lightTex, sunTex, p, dist, normalView);
        if (plant) {
            plantSun = texelFetch(plantSunTex, p, 0).r;
        }
    }
    float kind = passRan && !cloud ? lt.z : 0.0;
    bool water = kind > 0.0;
    //2026-10-29 (audit): translucent terrain blends the alpha (a + dst(1 - a)), so over a marked block (a smooth block's 245/246, an
    // ore's 252...) the code shifts into another mark's: gold under ice read as a light source. Where the lighting pass found a
    // translucent surface, the block marks mean nothing
    if (kind != 0.0) {
        plant = false;
        emissive = false;
        ore = false;
    }
    vec3 lightNormal = water ? vec3(0.0, 1.0, 0.0) : normalWorld;
    //The light levels at the surface: the light volume or the LOD light (unknown: full sky light, no block light, nothing relit)
    vec3 pl = pixelLight(p, size, world, lightNormal);
    bool known = pl.z > 0.5;
    vec3 albedo;
    bool hasAlbedo = pl.z > 1.5 && terrainAlbedoAt(p, albedo) && albedoMatches(albedo, colour.rgb, pl.y, pl.x);
    float sky = known ? pl.x : 15.0;
    float block = known ? pl.y : 0.0;
#ifdef PBR
    //Session 9: the front fragment's LabPBR material (pbr.glsl), where it is this pixel's own (its albedo matched) on terrain that is
    // not a plant, translucent or an LOD; rain on it by the sky open above (its diffuse factor: a porous one darkens)
    PbrMaterial mat;
    bool pbr = hasAlbedo && !plant && !cloud && !fromLod && kind == 0.0
            && pbrMaterial(imageLoad(terrainLight, p).r, imageLoad(terrainNormal, p).r, imageLoad(terrainSpecular, p).r, mat);
    float pbrFilm = 0.0;
    float pbrDiffuse = pbr ? pbrWet(mat, pbrWetAt(pbrParams.x, sky), normalWorld, pbrFilm) : 1.0;
#endif
    float skyT = sky;
    float blockT = block;
    if (water && !fromLod) {
        scene = flattenWaterTexture(p, size, scene, dist);
    }
    //2026-11-08: how much of the pixel is light: a light-emitting fluid's all of it, a light source's its bright texels (lightSourceShare of
    // its albedo, or vanilla's colour over vanilla's lightmap); the rest is lit as any block
    bool emissiveFluid = emissive && alphaCode(colour.a) == EMISSIVE_FLUID_ALPHA_CODE;
    float emission = 0.0;
    if (emissive && !cloud && !fromLod) {
        vec3 base = colour.rgb;
        if (hasAlbedo) {
            base = albedo;
        } else if (known) {
            base = min(colour.rgb/max(lightmapDisplay(block, sky), vec3(ORE_LIGHTMAP_MIN)), vec3(1.0));
        }
        emission = emissiveFluid ? 1.0 : lightSourceShare(base, normalWorld);
    }
    vec3 lit = scene;
    vec3 share = vec3(1.0);
    float sunPart = 0.0;
    if (!cloud && emission < 1.0) {
        bool ownSun = plant && plantSun >= 0.0;
        float direct = ownSun ? plantSun : lt.y;
        float visibility = ownSun ? plantSun : lt.w;
#ifdef PBR
        //Session 9: the normal map shades the face's direct sun; a scattering texel takes light through
        if (pbr) {
            direct *= pbrFacingRatio(mat.normal, normalWorld, a.sun.xyz);
            if (mat.sss > 0.0) {
                direct = pbrScatter(direct, mat.sss, lt.w > 0.0 ? lt.w : skyGate(clamp(sky/15.0, 0.0, 1.0)));
            }
        }
#endif
        if (known) {
            //Sky Light Ambient: the sky light lifted where the sun reaches (RelightMath.lift; lightFrac.w is 0 without valid sun visibility)
            if (passRan) {
                skyT = liftedSky(sky, clamp(visibility, 0.0, 1.0)*clamp(lightFrac.w, 0.0, 1.0));
            }
            //B12: water that sees the sky sideways keeps that sky light
            if (water && !fromLod && lightMode.z > 0.5) {
                skyT = max(skyT, 15.0*waterSky(sky, sideSky(world)));
            }
            //B16: the held light, where the light volume is known
            if (heldOrigin.w > 0.5 && lightCamera.w > 0.5 && !fromLod) {
                blockT = max(blockT, heldLevelAt(lightFrac.xyz + world, dot(lightNormal, lightNormal) > 0.25 ? lightNormal : -world));
            }
        }
        //Final fix R5: each lightmap colour is sampled once; equal levels reuse a sample (unknown light: one sample, nothing relit)
        vec3 lightAll = lightmapLinear(blockT, skyT);
        vec3 lightSky = blockT == block ? lightAll : lightmapLinear(block, skyT);
        vec3 lightNow = skyT == sky ? lightSky : lightmapLinear(block, sky);
        vec3 dark = vec3(0.0);
        vec3 skyOnly = vec3(0.0);
        vec3 blockOnly = vec3(0.0);
        vec3 gain = vec3(1.0);
        bool capped = false;
        //The scene at the new light (sky lift, side sky, held light) before the shading
        vec3 relit = scene;
        if (known) {
            if (hasAlbedo) {
                //2026-10-23: vanilla's own product at the new levels, the held light's too: no gain cap, no stretched 8-bit steps
                relit = vanillaToScene(albedo*lightmapDisplay(blockT, skyT));
            } else {
                gain = relightGain(lightNow, lightSky);
                capped = relightCapped(lightNow, lightSky);
                if (blockT > block) {
                    vec3 held = min(lightAll/max(lightSky, vec3(1e-4)), vec3(HELD_MAX_GAIN));
                    vec3 base = scene*gain;
                    float scale = heldRoom(max(base.r, max(base.g, base.b)), max(max(held.r, max(held.g, held.b)), 1.0),
                            max(lightAll.r, max(lightAll.g, lightAll.b)));
                    gain *= max(held*scale, vec3(1.0));
                }
                relit = scene*gain;
            }
            dark = lightmapLinear(0.0, 0.0);
            skyOnly = skyT == 0.0 ? dark : (blockT == 0.0 ? lightAll : lightmapLinear(0.0, skyT));
            blockOnly = blockT == 0.0 ? dark : (skyT == 0.0 ? lightAll : lightmapLinear(blockT, 0.0));
            share = skyLitShare(skyOnly, lightAll, dark);
        }
        float skyLight = clamp(skyT/15.0, 0.0, 1.0);
        float sunWeight = passRan ? lighting.y : 0.0;
        float shade = 1.0;
        if (!plant && kind == 0.0) {
            //Water, ice, glass and slime are vanilla's texel blended over what lies behind, which that face never shaded
            shade = fromLod ? mix(1.0, bakedShade(lightNormal), LOD_FACE_SHADE_SHARE) : bakedShade(lightNormal);
        }
        float skyFactor = sunShadingAt(direct, skyLight, sunWeight, lighting.w)*faceUnshade(shade, sunWeight);
        float directShare = sunShare(direct, skyLight);
        float shadeL = shadeLevel(lighting.w);
        float sunL = sunLevel(lighting.w);
        sunPart = (sunL - shadeL)*directShare/(shadeL + (sunL - shadeL)*directShare);
        vec3 tint = (passRan ? lightTint(directShare, lightSun.w*lightShade.w, lightSun.rgb, lightShade.rgb) : vec3(1.0))*moonTint(moonLightColour);
        //The exposures (final fix R1): the sky-light ones not on light the active volume does not know yet (a section still loading);
        // with the volume off every vanilla pixel takes them on its lightmap share (all sky-lit), as its LOD neighbours do (follow-up 1).
        // The block light's falls on the known block-lit share alone
        bool exposed = known || lightCamera.w < 0.5;
        float se = exposed ? skyExposure(waterParams.z, waterParams.w, look) : 1.0;
        if (exposed && exposureMode(ATMOSPHERE_SKY)) {
            se *= skyWeatherExposure(lookParams.z, waterParams.z, waterParams.w, look);
        }
        float be = blockExposure(waterParams.z, look);
        //2026-10-28: the block-lit light's colour and falloff (1 where nothing is block-lit)
        vec3 blockShare = (vec3(1.0) - share)*be;
        if (known && blockLightColour.w > 0.0) {
            blockShare *= blockLightFactor((vec3(1.0) - share)*lightAll, (vec3(1.0) - share)*dark, blockOnly, lightmapLinear(15.0, 0.0), dark,
                    blockLightColour.rgb, blockLightColour.w);
        }
        //What the lighting does to a white texel's light here, per channel
        vec3 perLight = share*skyFactor*tint*se + blockShare;
        //W10: per channel, the share of perLight the ambient occlusion leaves. It takes the sky light's ambient part (the sun shading at
        // no direct sun, with the face unshade, tint and exposure the sky-lit share gets) and the lightmap's floor in the block-lit share
        vec3 ao = vec3(1.0);
#ifdef PBR
        //Session 9: the material AO darkens the same ambient part, with or without the screen-space one
        float pbrAo = pbr ? mix(1.0, mat.ao, PBR_AO_STRENGTH) : 1.0;
        if (passRan && (lighting.x > 0.0 || pbrAo < 1.0)) {
            float occlusion = (lighting.x > 0.0 ? aoStrengthApplied(aoAt(aoTex, p, dist), lighting.x) : 1.0)*pbrAo;
#else
        if (passRan && lighting.x > 0.0) {
            float occlusion = aoStrengthApplied(aoAt(aoTex, p, dist), lighting.x);
#endif
            if (occlusion < 1.0) {
                vec3 floorShare = known ? aoFloorShare(skyOnly, blockOnly, dark) : vec3(0.0);
                vec3 occludable = share*sunShadingAt(0.0, skyLight, sunWeight, lighting.w)*faceUnshade(shade, sunWeight)*tint*se
                        + blockShare*floorShare;
                ao = aoOccludedLight(perLight, occludable, occlusion);
            }
        }
        lit = relit*perLight*ao;
#ifdef PBR
        if (pbrDiffuse < 1.0) {
            lit = pbrWetColour(lit, pbrDiffuse);
        }
#endif
        if (exposureMode(ATMOSPHERE_NO_SKY)) {
            lit *= looked(NO_SKY_EXPOSURE, look);
        }
        if (water && capped) {
            //Gate G7l: water whose vanilla light was too dark to scale keeps its body's scattering floor
            lit = max(lit, lightAll*perLight*LIGHT_WATER_ALBEDO);
        }
        if (water) {
            //W6: the water's colour over its depth, lit by what a white texel here receives (before the haze); 2026-11-10 (session 8): the
            // light times the picked water colour's tint is the body colour times it (waterColour uses light only there)
#ifdef ATMOSPHERE_TINTS
            lit = waterColour(lit, kind*waterParams.x, lightAll*perLight*ao*waterParams.y*waterTint.rgb);
#else
            lit = waterColour(lit, kind*waterParams.x, lightAll*perLight*ao*waterParams.y);
#endif
        }
    }
    //2026-10-28: light sources glow (2026-11-08: their share that is light); an ore's specks add their own light (its albedo, or vanilla's
    // colour over vanilla's lightmap)
    if (emission > 0.0) {
        lit = mix(lit, tintedGlow(scene*lightGlow(colour.rgb, glowParams.x*(emissiveFluid ? FLUID_GLOW_SCALE : 1.0))), emission);
    } else if (ore && !cloud && !fromLod && glowParams.y > 0.0) {
        vec3 base = colour.rgb;
        bool readable = true;
        if (hasAlbedo) {
            base = albedo;
        } else if (known) {
            vec3 lmd = lightmapDisplay(block, sky);
            readable = max(lmd.r, max(lmd.g, lmd.b)) >= ORE_LIGHTMAP_MIN;
            base = min(colour.rgb/max(lmd, vec3(ORE_LIGHTMAP_MIN)), vec3(1.0));
        }
        if (readable) {
            float speck = oreSpeckAt(p, size, colour.rgb, oreHostStep(size, dist));
            lit += oreGlow(base, speck, bakedShade(normalWorld), glowParams.y);
        }
    }
    //2026-10-29: polished and metal blocks catch the sun's and the moon's light (blockreflect.glsl; block reflections 1 and 2, slot 33
    // .z): the sun's at its visibility and this frame's day (slot 23 .w), the moon's at its strength (slot 32 .w), both where the sky
    // reaches. At 2 the reflection pass adds what they mirror (the mark below)
    int smoothClass = passRan && !cloud && !fromLod && !emissive && !plant && kind == 0.0 && glowParams.z > 0.5 ? blockCodeClass(alphaCode(colour.a)) : 0;
#ifdef PBR
    //Session 9: a texel with a specular map takes its own: its emission, its highlights (and with the PBR reflections on, a mark that
    // has the reflection pass mirror it; a mirroring metal keeps a share of its diffuse light) in place of the smooth blocks' class. A light
    // source (vanilla's mark, or a glowing texel) keeps its glow: no highlight or mirror over it (a sea lantern mirrored the night sky)
    float pbrMarkValue = 0.0;
    if (pbr && mat.emission > 0.0) {
        lit = mix(lit, tintedGlow(vanillaToScene(albedo)*lightGlow(albedo, glowParams.x)*PBR_EMISSION_GAIN), mat.emission);
    }
    if (pbr && mat.specular && !emissive && mat.emission <= 0.0) {
        smoothClass = 0;
        vec3 f0 = pbrF0(mat, albedo);
        float gate = skyGate(clamp(skyT/15.0, 0.0, 1.0));
        vec3 sunLit = lightSun.rgb*(clamp(lightShade.w, 0.0, 1.0)*clamp(lt.w, 0.0, 1.0)*gate);
        vec3 moonLit = moonLightColour.rgb*(MOON_HIGHLIGHT*max(moonLightColour.w, 0.0)*gate);
        bool mirrors = pbrParams.y > 0.5 && passRan && pbrReflects(mat);
        if (mirrors && mat.metal >= 0) {
            lit *= PBR_METAL_DIFFUSE;
        }
        lit += pbrHighlight(mat, f0, -dir, a.sun.xyz, sunLit) + pbrHighlight(mat, f0, -dir, -a.sun.xyz, moonLit);
        if (mirrors) {
            pbrMarkValue = pbrMark(mat, pbrFilm, albedo);
        }
    }
#endif
    if (smoothClass > 0 && dot(normalWorld, normalWorld) > 0.25) {
        float gate = skyGate(clamp(skyT/15.0, 0.0, 1.0));
        vec3 tint = smoothClass == 2 ? metalTint(colour.rgb) : vec3(1.0);
        vec3 sunLit = lightSun.rgb*(clamp(lightShade.w, 0.0, 1.0)*clamp(lt.w, 0.0, 1.0)*gate);
        vec3 moonLit = moonLightColour.rgb*(MOON_HIGHLIGHT*max(moonLightColour.w, 0.0)*gate);
        lit += blockHighlight(smoothClass, normalWorld, -dir, a.sun.xyz, sunLit, tint)
                + blockHighlight(smoothClass, normalWorld, -dir, -a.sun.xyz, moonLit, tint);
    }
    int debug = int(lightMode.x + 0.5);
    if (debug >= DEBUG_SKY_VIEW && debug <= DEBUG_SHARE_VIEW) {
        return vec4(debugView(debug, known, skyT, blockT, share, sunPart), 0.0);
    }
    if (debug == DEBUG_SOURCE_VIEW) {
        return vec4(sourceView(pl.z, fromLod, hasAlbedo), 0.0);
    }
    //W4's haze over the view distance: the sky light given to sunShadingAt (the lifted one); water its own unlifted sky light, as W6's
    // reflection hazes the reflected colour; LOD pixels full
    float hazeSky = water ? skyShare(sky) : clamp(skyT/15.0, 0.0, 1.0);
    float amount = hazeAmount(a, known && !cloud ? hazeSky : 1.0, fromLod);
    //2026-11-10 (the user: at sunrise and sunset the sun shone through ice spikes and hills): the sun's glow in front of a surface only
    // as far as the sun's disc is open on screen (sunopen.glsl; near the sun only)
    float sunOpen = 1.0;
    float sunWeight = atmosphereSky(a) ? sunOpenWeight(dot(dir, a.sun.xyz)) : 0.0;
    if (sunWeight > 0.0) {
        sunOpen = sunOpenAt(sunOpenShareValue, sunWeight);
    }
    lit = applyHazeOpen(a, lit, dir, dist, amount, sunOpen);
    float border = atmosphereSky(a) ? borderAmount(world, fromLod) : 0.0;
    if (border > 0.0) {
        lit = mix(lit, skyColour(a, dir) + glowLobeOpen(a, dir, sunOpen)*glowGain(skyAirMass(dir.y)), border);
    }
    if (!cloud) {
        lit = weatherFogOver(a, lit, dir, dist, amount);
    }
    lit = farCloudsOver(a, lit, dir, dist, p);
    //2026-10-29 (the user: raindrops took the water's reflection): a pixel drawn over after the translucent terrain (rain and snow
    // particles, splashes, ripples) keeps no mark (overdrawn, from main), so it stays as drawn instead of being mirrored over
    //2026-11-09 (session 2b): from inside water, through the water (or the surface's window)
    vec3 shown = lit*underwaterExposure();
    if (cameraUnderwater()) {
        shown = underwaterView(p, size, dir, dist, false, shown);
    }
#ifdef PBR
    return vec4(shown, passRan && !cloud && !overdrawn
            ? (kind != 0.0 ? reflectionMark(kind) : (pbrMarkValue < 0.0 ? pbrMarkValue : blockReflectionMark(smoothClass, glowParams.z))) : 0.0);
#else
    return vec4(shown,
            passRan && !cloud && !overdrawn ? (kind != 0.0 ? reflectionMark(kind) : blockReflectionMark(smoothClass, glowParams.z)) : 0.0);
#endif
}

//2026-11-11 (the user: in snowy weather the snowflakes looked see-through; Particle Rain's flakes, also vanilla's fading particles): a
// translucent particle is blended by vanilla over vanilla's own background (its blue sky, its unhazed land) and writes the depth, so
// the composite lit the blend as a surface at the particle's distance and vanilla's background showed through it. Here such a pixel
// is taken apart: its cover (alpha) is where the final colour lies between the colour before the particles (colourAfterTranslucent)
// and the particle's own colour (its albedo, which particle.fsh also writes for translucent fragments, times vanilla's lightmap); the
// particle is composited as an opaque surface at its colour and laid at that cover over the composite's background, taken from the
// pixels of the same tile that nothing was drawn over and that showed the same colour before the particles (a cross-bilateral
// weight on that colour: the sky behind a flake takes the sky's pixels, the hill the hill's). SceneCompositeMath mirrors the steps.
//Below this squared distance (display values) between the particle's colour and the one behind it its cover cannot be told
const float PARTICLE_COVER_SPREAD_MIN = 0.0004;
//A cover at least this is drawn as before: the particle alone
const float PARTICLE_COVER_OPAQUE = 0.98;
//A pixel the blend of the particle over what was behind does not explain within this squared distance (display values) is drawn as
// before: particles overlapping there (a puff of smoke over another, the front one's dark rim chose a full cover: black specks)
const float PARTICLE_BLEND_RESIDUAL_MAX = 0.0025;
//The tile pixels' weight: exp(-d²/PARTICLE_BEHIND_MATCH²), d the distance between their colours before the particles and this one's
const float PARTICLE_BEHIND_MATCH = 0.05;
//The guess of what lies behind a particle (particleBehindGuess) counts as this much weight among the tile's pixels: where few showed
// it (a large particle over the whole tile) the guess stands in, and the two blend without a step from one tile to the next
const float PARTICLE_GUESS_WEIGHT = 0.5;
const uint COMPOSITE_TILE = 64u;

//The particle's cover where shown is drawn over behind (both display values) by a particle of colour own: shown's share of the way
// from behind to own (vanilla's blend shown = own a + behind (1 - a)); 1 where the two colours are too close to tell or that blend
// does not explain shown
float particleCover(vec3 shown, vec3 behind, vec3 own) {
    vec3 e = own - behind;
    float ee = dot(e, e);
    if (ee < PARTICLE_COVER_SPREAD_MIN) {
        return 1.0;
    }
    float cover = clamp(dot(shown - behind, e)/ee, 0.0, 1.0);
    vec3 r = shown - behind - e*cover;
    return dot(r, r) > PARTICLE_BLEND_RESIDUAL_MAX ? 1.0 : cover;
}

//A pixel drawn over after the translucent terrain whose front fragment wrote the terrain light and its albedo (a particle): its own
// colour (display values, before vanilla's blend) and cover; false when it covers at least PARTICLE_COVER_OPAQUE (drawn as before)
bool translucentParticle(ivec2 p, vec3 shown, vec3 behind, out vec3 own, out float cover) {
    own = shown;
    cover = 1.0;
    vec3 t = terrainLightAt(p, texelFetch(mainDepth, p, 0).r);
    vec3 albedo;
    if (t.z < 1.5 || !terrainAlbedoAt(p, albedo)) {
        return false;
    }
    own = albedo*lightmapDisplay(t.y, t.x);
    cover = particleCover(shown, behind, own);
    return cover < PARTICLE_COVER_OPAQUE;
}

//The guess of what lies behind a translucent particle where few pixels of its tile showed it: vanilla's colour there hazed and fogged at
// its own distance (the depth before the translucent terrain), or the sky and its glow where there is none
vec3 particleBehindGuess(ivec2 p, ivec2 size, vec3 behind) {
    Atmosphere a = Atmosphere(atmosphereSun, atmosphereSunLight, atmosphereMoonLight, atmosphereDepth, atmosphereAmbient, atmosphereGlow, atmosphereFog,
            atmosphereFogTint, atmosphereOvercastTint, atmosphereMoonTint);
    vec3 scene = vanillaToScene(behind);
    if (!atmosphereOn(a) || abs(a.sun.w - ATMOSPHERE_NO_SKY) < 0.5 || cameraUnderwater()) {
        return scene*underwaterExposure();
    }
    vec2 uv = pixelUvGl(p, size);
    vec3 dir = normalize(mat3(invView)*viewRay(invVanillaProj, uv));
    float depth = texelFetch(beforeTranslucent, p, 0).r;
    if (depth == FAR) {
        return skyColour(a, dir) + sunGlow(a, dir);
    }
    float dist = length(viewPosition(invVanillaProj, uv, depth));
    float amount = hazeAmount(a, 1.0, false);
    return weatherFogOver(a, applyHazeOpen(a, scene, dir, dist, amount, 1.0), dir, dist, amount);
}

#ifdef SKY_HALF_PASS
//Session 14 follow-up (Half-resolution Weather & Sky): the far clouds and the aurora at half the size, each texel for its 2x2 block's
// farthest pixel (the sky if any), the jitter on the half-size grid (on the full one every other pixel of it: diagonal stripes)
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 hs = imageSize(skyHalfCloud);
    if (any(greaterThanEqual(p, hs))) {
        return;
    }
    ivec2 size = imageSize(sceneOut);
    ivec2 q = min(p*2, size - 1);
    float best = texelFetch(mainDepth, q, 0).r;
    for (int i = 1; i < 4; i++) {
        ivec2 c = min(p*2 + ivec2(i & 1, i >> 1), size - 1);
        float d = texelFetch(mainDepth, c, 0).r;
        if (d > best) {
            best = d;
            q = c;
        }
    }
    Atmosphere a = Atmosphere(atmosphereSun, atmosphereSunLight, atmosphereMoonLight, atmosphereDepth, atmosphereAmbient, atmosphereGlow, atmosphereFog,
            atmosphereFogTint, atmosphereOvercastTint, atmosphereMoonTint);
    vec3 dir = normalize(mat3(invView)*viewRay(invVanillaProj, pixelUvGl(q, size)));
    vec3 view;
    bool scene = scenePosition(q, size, view);
    float dist = scene ? length(view) : HAZE_MAX_DISTANCE;
    vec4 m = vec4(0.0);
    float near = farCloudNear();
    if (cloudShape.w >= 0.5 && atmosphereSky(a) && dist > near) {
        m = farCloudMarch(dir*near, dir, dist - near, cloudLightDir.xyz, interleavedGradientNoise(vec2(p)));
        m.w += near;
    }
    imageStore(skyHalfCloud, p, m);
    //The aurora as the mean of two of the block's pixels (its diagonal), each with the full size's samples and half a step of jitter apart
    // (one direction a texel left coarse curved bands of the march's steps at 1280x720), the rays faded where finer than a texel
    vec3 au = vec3(0.0);
    if (!scene && auroraParams.x > 0.0 && halfParams.y > 0.5) {
        float pixelAngle = 2.0*abs(invVanillaProj[1][1])/float(hs.y);
        float jitter = fract(interleavedGradientNoise(vec2(p)) + auroraParams.w);
        for (int k = 0; k < 2; k++) {
            ivec2 c = min(p*2 + ivec2(k), size - 1);
            vec3 d = normalize(mat3(invView)*viewRay(invVanillaProj, pixelUvGl(c, size)));
            float jk = fract(jitter + 0.5*float(k));
#ifdef ATMOSPHERE_TINTS
            au += aurora(d, auroraParams, auroraTintLow.rgb, auroraTintMid.rgb, auroraTintTop.rgb, HALF_SKY_AURORA_STEPS, jk, pixelAngle);
#else
            au += aurora(d, auroraParams, vec3(1.0), vec3(1.0), vec3(1.0), HALF_SKY_AURORA_STEPS, jk, pixelAngle);
#endif
        }
        au *= 0.5;
    }
    imageStore(skyHalfAurora, p, vec4(au, min(dist, HALF_SKY_FAR)));
}
